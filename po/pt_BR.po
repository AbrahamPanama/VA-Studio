#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:114
msgid ""
"background-color <hexadezimal>: the color of the background that should be "
"ignored, for example FFFFFF; default is no background color."
msgstr ""
"background-color <hexadecimal>: a cor do fundo que deve ser ignorada, por "
"exemplo FFFFFF; o padrão é nenhuma cor de fundo."

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:120
msgid ""
"charcode <unsigned>: code of character to load from GF file, allowed are "
"0..255; default is the first character in font."
msgstr ""
"charcode <unsigned>: código do caractere a ser carregado do arquivo GF, os "
"valores permitidos são de 0 a 255; o padrão é o primeiro caractere da fonte."

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:125
msgid ""
"color-count <unsigned>: number of colors a color bitmap is reduced to, it "
"does not work on grayscale, allowed are 1..256; default is 0, that means not "
"color reduction is done."
msgstr ""
"color-count <unsigned>: número de cores para as quais um bitmap colorido é "
"reduzido; não funciona em tons de cinza; os valores permitidos são de 1 a "
"256; o padrão é 0, o que significa que nenhuma redução de cor é feita."

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:131
msgid ""
"corner-always-threshold <angle-in-degrees>: if the angle at a pixel is less "
"than this, it is considered a corner, even if it is within `corner-surround' "
"pixels of another corner; default is 60. "
msgstr ""
"corner-always-threshold <ângulo-em-graus>: se o ângulo em um pixel for menor "
"que este valor, ele será considerado um canto, mesmo que esteja dentro de "
"`corner-surround` pixels de outro canto; o padrão é 60. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:137
msgid ""
"corner-surround <unsigned>: number of pixels on either side of a point to "
"consider when determining if that point is a corner; default is 4. "
msgstr ""
"corner-surround <unsigned>: número de pixels em cada lado de um ponto a "
"serem considerados ao determinar se esse ponto é um canto; o padrão é 4. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:143
msgid ""
"corner-threshold <angle-in-degrees>: if a pixel, its predecessor(s), and its "
"successor(s) meet at an angle smaller than this, it's a corner; default is "
"100. "
msgstr ""
"corner-threshold <ângulo-em-graus>: se um pixel, seu(s) predecessor(es) e "
"seu(s) sucessor(es) se encontrarem em um ângulo menor que este, é um canto; "
"o padrão é 100. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:149
msgid ""
"error-threshold <real>: subdivide fitted curves that are off by more pixels "
"than this; default is 2.0. "
msgstr ""
"error-threshold <real>: subdivide as curvas ajustadas que apresentam um erro "
"superior a este valor em pixels; o padrão é 2,0. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:154
msgid ""
"filter-iterations <unsigned>: smooth the curve this many times before "
"fitting; default is 4."
msgstr ""
"filter-iterations <unsigned>: suaviza a curva este número de vezes antes do "
"ajuste; o padrão é 4."

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:159
msgid ""
"line-reversion-threshold <real>: if a spline is closer to a straight line "
"than this, weighted by the square of the curve length, keep it a straight "
"line even if it is a list with curves; default is .01. "
msgstr ""
"line-reversion-threshold <real>: se uma spline estiver mais próxima de uma "
"linha reta do que este valor, ponderado pelo quadrado do comprimento da "
"curva, mantenha-a como uma linha reta mesmo que seja uma lista com curvas; o "
"padrão é 0,01. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:165
msgid ""
"line-threshold <real>: if the spline is not more than this far away from the "
"straight line defined by its endpoints,then output a straight line; default "
"is 1. "
msgstr ""
"line-threshold <real>: se a spline não estiver a mais do que esta distância "
"da linha reta definida por seus pontos finais, então produz uma linha reta; "
"o padrão é 1. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:171
msgid ""
"remove-adjacent-corners: remove corners that are adjacent; default doesn't "
"remove."
msgstr ""
"remove-adjacent-corners: remove cantos adjacentes; o padrão não remove."

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:176
msgid ""
"tangent-surround <unsigned>: number of points on either side of a point to "
"consider when computing the tangent at that point;  default is 3."
msgstr ""
"tangent-surround <unsigned>: número de pontos em cada lado de um ponto a "
"serem considerados ao calcular a tangente nesse ponto; o padrão é 3."

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:182
msgid "despeckle-level <unsigned>: 0..20; default is no despeckling. "
msgstr ""
"despeckle-level <unsigned>: 0..20; o padrão é nenhuma remoção de ruído. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:186
msgid "despeckle-tightness <real>: 0.0..8.0; default is 2.0. "
msgstr "despeckle-tightness <real>: 0.0..8.0; o padrão é 2.0. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:190
msgid "noise-removal <real>: 1.0..0.0; default is 0.99. "
msgstr "noise-removal <real>: 1.0..0.0; o padrão é 0.99. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:194
msgid "centerline: trace a character's centerline, rather than its outline. "
msgstr ""
"centerline: trace a linha central de um personagem, em vez de seu contorno. "

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:198
msgid ""
"preserve-width: whether to preserve linewith with centerline fitting; "
"default doesn't preserve."
msgstr ""
"preserve-width: indica se a largura da linha deve ser preservada com o "
"ajuste da linha central; o padrão não preserva."

#: ../src/3rdparty/autotrace/include/autotrace/autotrace.h:203
msgid "width-weight-factor <real>: weight factor for fitting the linewidth."
msgstr ""
"fator-peso-largura <real>: fator de ponderação para ajustar a largura da "
"linha."


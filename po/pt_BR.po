msgid ""
"Add a dashed stroke whose dashes end exactly on a node, optionally with the "
"same number of dashes per path segment"
msgstr ""
"Adicione um traço tracejado cujos traços terminem exatamente em um nó, "
"opcionalmente com o mesmo número de traços por segmento de caminho"

#: ../src/live_effects/effect.cpp:653
msgctxt "path effect"
msgid "Boolean operation"
msgstr "Operação de Formas"


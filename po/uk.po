msgstr "Експорт до SVG"

#: ../src/ui/dialog/inkscape-preferences.cpp:2482
msgid "SVG 2"
msgstr "SVG 2"

#: ../src/ui/dialog/inkscape-preferences.cpp:2483
msgid "Insert SVG 1.1 fallback in text"
msgstr "Вставити резервний код SVG 1.1 у текст"


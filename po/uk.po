msgstr ""
"Малювання перпендикуляра посередині (уявної) лінії, яка з'єднує початковий і "
"кінцевий вузли"

#: ../src/live_effects/effect.cpp:795
msgctxt "path effect"
msgid "Tangent to curve"
msgstr "Дотична до кривої"

#: ../src/live_effects/effect.cpp:798

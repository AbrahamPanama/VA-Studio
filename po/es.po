#: ../src/ui/dialog/explode-bitmap.cpp
msgid "Generated images can contain nearly invisible dust that becomes extra pieces. Ignore pixels at or below this opacity, even with Refine transparency off."
msgstr "Las imágenes generadas pueden contener polvo casi invisible que se convierte en piezas adicionales. Ignora los píxeles con esta opacidad o menor, incluso con Refinar transparencia desactivado."

#: ../src/ui/dialog/explode-bitmap.cpp
msgid "Ignore pixels at or below this opacity: 0–25%. Applies before refinement and also when Refine transparency is off."
msgstr "Ignora los píxeles con esta opacidad o menor: 0–25 %. Se aplica antes del refinamiento y también cuando Refinar transparencia está desactivado."

#: ../src/ui/dialog/explode-bitmap.cpp
msgid "Preview only. Apply adjustment or Explode to keep these changes."
msgstr "Solo vista previa. Aplica el ajuste o explota para conservar estos cambios."

#: ../src/ui/dialog/explode-bitmap.cpp
msgid "Adjustment applied. Further adjustments change these pixels again. Use Undo to restore the previous image."
msgstr "Ajuste aplicado. Los ajustes posteriores volverán a cambiar estos píxeles. Usa Deshacer para restaurar la imagen anterior."

#: ../src/ui/dialog/explode-bitmap.cpp
msgid "%1 pieces found. Explode Bitmap supports up to 150 pieces per operation. Adjust the transparency settings or simplify the image."
msgstr "Se encontraron %1 piezas. Explotar bitmap admite hasta 150 piezas por operación. Ajusta la transparencia o simplifica la imagen."


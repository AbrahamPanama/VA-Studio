msgid "Select in all layers"
msgstr "Chọn trong toàn bộ các tầng lớp"

#: ../src/ui/dialog/inkscape-preferences.cpp:2647
msgid "Select only within current layer"
msgstr "Duy chọn nội trong tầng lớp hiện tại mà thôi"


msgid "Bend path:"
msgstr "Bẻ cổng đường dẫn:"

#: ../src/live_effects/lpe-bendpath.cpp:67
msgid "Path along which to bend the original path"
msgstr "Đường dẫn để uốn cổng đường dẫn gốc trên ấy"


msgstr ""
"Objektuaren 'estiloa' eta 'klasea' balioak hitzez hitz kopiatuko dira, eta "
"jomugako objektuarenak ordezkatuko ditu 'Itsatsi estiloa' erabiltzean"

#: ../src/ui/dialog/inkscape-preferences.cpp:2951
msgid "Clipboard"
msgstr "Arbela"

#: ../src/ui/dialog/inkscape-preferences.cpp:2954
msgid "Document cleanup"
msgstr "Dokumentuaren garbiketa"

#: ../src/ui/dialog/inkscape-preferences.cpp:2955
#: ../src/ui/dialog/inkscape-preferences.cpp:2957

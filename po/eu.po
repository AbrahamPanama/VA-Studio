msgstr "Letra-tipo baten eskemaren pisua kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:166
msgid "Controls the width of an engraving"
msgstr "Grabatzearen zabalera kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:167
msgid "Controls the depth of an emboss"
msgstr "Bozeltzearen sakonera kontrolatzen du"


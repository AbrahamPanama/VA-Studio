#. TRANSLATORS: “Grade” (GRAD in CSS) is an axis that can be used to alter stroke thicknesses (or other forms)
#. without affecting the type's overall width, inter-letter spacing, or kerning — unlike altering weight.
#: ../src/ui/widget/font-variations.cpp:53
msgid ""
"Alter stroke thicknesses (or other forms) without affecting the type’s "
"overall width"
msgstr ""
"Moldatu trazuen lodiera (edo beste forma batzuk) motaren zabalera orokorra "
"aldatu gabe"

#. TRANSLATORS: “Parametric Thick Stroke”, XOPQ, is a reference to its logical name, “X Opaque”,
#. which describes how it alters the opaque stroke forms of glyphs typically in the X dimension
#: ../src/ui/widget/font-variations.cpp:56
msgid "Alter the opaque stroke forms of glyphs in the X dimension"
msgstr "Moldatu glifoen trazu-forma opakuak X dimentsioan"

#. TRANSLATORS: “Parametric Thin Stroke”, YOPQ, is a reference to its logical name, “Y Opaque”,
#. which describes how it alters the opaque stroke forms of glyphs typically in the Y dimension
#: ../src/ui/widget/font-variations.cpp:59
msgid "Alter the opaque stroke forms of glyphs in the Y dimension"
msgstr "Moldatu glifoen trazu-forma opakuak Y dimentsioan"

#. TRANSLATORS: “Parametric Counter Width”, XTRA, is a reference to its logical name, “X-Transparent,”
#. which describes how it alters a font’s transparent spaces (also known as negative shapes)
#. inside and around all glyphs along the X dimension
#: ../src/ui/widget/font-variations.cpp:63
msgid ""
"Alter the transparent spaces inside and around all glyphs along the X "
"dimension"
msgstr ""
"Moldatu glifo guztien barruko eta inguruko zuriune garden guztiak X "
"dimentsioan"

#: ../src/ui/widget/font-variations.cpp:64
msgid ""
"Alter the transparent spaces inside and around all glyphs along the Y "
"dimension"
msgstr ""
"Moldatu glifo guztien barruko eta inguruko zuriune garden guztiak Y "
"dimentsioan"

#. TRANSLATORS: Width/height of Chinese glyphs
#: ../src/ui/widget/font-variations.cpp:66
msgid "Alter the width of Chinese glyphs"
msgstr "Moldatu glifo txinatarren zabalera"

#: ../src/ui/widget/font-variations.cpp:67
msgid "Alter the height of Chinese glyphs"
msgstr "Moldatu glifo txinatarren altuera"

#. TRANSLATORS: “Parametric Lowercase Height”
#: ../src/ui/widget/font-variations.cpp:69
msgid ""
"Vary the height of counters and other spaces between the baseline and x-"
"height"
msgstr ""
"Moldatu oinarri-lerroaren eta X altueraren arteko kontraespazioak eta beste "
"espazio batzuk"

#. TRANSLATORS: “Parametric Uppercase Counter Height”
#: ../src/ui/widget/font-variations.cpp:71
msgid "Vary the height of uppercase letterforms"
msgstr "Moldatu letra-forma maiuskulen altuera"

#. TRANSLATORS: “Parametric Ascender Height”
#: ../src/ui/widget/font-variations.cpp:73
msgid "Vary the height of lowercase ascenders"
msgstr "Moldatu goranzko minuskulen altuera"

#. TRANSLATORS: “Parametric Descender Depth”
#: ../src/ui/widget/font-variations.cpp:75
msgid "Vary the depth of lowercase descenders"
msgstr "Moldatu beheranzko minuskulen sakonera"

#. TRANSLATORS: “Parametric Figure Height”
#: ../src/ui/widget/font-variations.cpp:77
msgid "Vary the height of figures"
msgstr "Moldatu zenbakien altuera"

#. TRANSLATORS: "Serif rise" - found in the wild (https://github.com/googlefonts/amstelvar)
#: ../src/ui/widget/font-variations.cpp:79
msgid "Vary the shape of the serifs"
msgstr "Moldatu serif tipoen forma"

#. TRANSLATORS: Flare - flaring of the stems
#: ../src/ui/widget/font-variations.cpp:81
msgid "Controls the flaring of the stems"
msgstr "Zurtoinen zabalkuntza kontrolatzen du"

#. TRANSLATORS: Volume - The volume axis works only in combination with the Flare axis. It transforms the serifs
#. and adds a little more edge to details.
#: ../src/ui/widget/font-variations.cpp:84
msgid "Volume works in combination with flare to transform serifs"
msgstr "Bolumena zabalkuntzarekin konbinatzen da serif tipoak eraldatzeko"

#: ../src/ui/widget/font-variations.cpp:86
msgid "Softness makes letterforms more soft and rounded"
msgstr "Biguntasunari esker, letra-formak bigunagoak eta biribilagoak dira"

#: ../src/ui/widget/font-variations.cpp:88
msgid "Adjust the letterforms from a more serious style to a more casual style"
msgstr "Doitu letra-formak estilo serioagotik estilo informalagora"

#: ../src/ui/widget/font-variations.cpp:90
msgid "Control the substitution of cursive forms"
msgstr "Kontrolatu forma etzanen ordezkapena"

#: ../src/ui/widget/font-variations.cpp:92
msgid "Fill can turn transparent forms opaque"
msgstr "Betegarriak forma gardenak opaku bihurtzen ditu"

#: ../src/ui/widget/font-variations.cpp:94
msgid "Adjust the glyphs from a proportional width to a fixed width"
msgstr "Doitu glifoak zabalera proportzionaletik zabalera finkora"

#: ../src/ui/widget/font-variations.cpp:96
msgid "Binary switch used to control substitution of “wonky” forms"
msgstr ""
"Forma \"ezegonkorren\" ordezkapena kontrolatzeko erabilitako etengailu "
"bitarra"

#: ../src/ui/widget/font-variations.cpp:98
msgid "Selection of the base element glyphs are composed of"
msgstr "Glifoak osatzeko erabiliko den oinarri-elementuaren hautapena"

#: ../src/ui/widget/font-variations.cpp:100
msgid "Controls element shape characteristics"
msgstr "Elementu-formaren ezaugarriak kontrolatzen ditu"

#: ../src/ui/widget/font-variations.cpp:102
#: ../src/ui/widget/font-variations.cpp:104
msgid "Controls how many elements are used per one grid unit"
msgstr ""
"Sareta-unitate bakoitzeko zenbat elementu erabiltzen diren kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:106
msgid "Controls the font file’s height parameter"
msgstr "Letra-tipoaren altuera-parametroa kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:108
msgid "Controls stem thickness in vertical direction"
msgstr "Zurtoinek bertikalean duten lodiera kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:110
msgid "Controls vertical element alignment"
msgstr "Elementuaren lerrokatze bertikala kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:112
msgid "Controls corner roundness"
msgstr "Izkinen biribiltasuna kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:114
msgid "Controls ink bleed effect"
msgstr "Tintaren jarioaren efektua kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:116
msgid "Controls scanline effect"
msgstr "Eskaneatze-marren efektua kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:118
msgid "Controls morphing characteristics"
msgstr "Ezaugarri morfologikoak kontrolatzen ditu"

#: ../src/ui/widget/font-variations.cpp:120
msgid "Controls depth of extrusion"
msgstr "Estrusio-sakonera kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:122
msgid "Controls edge highlighting"
msgstr "Ertz-nabarmentzea kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:124
msgid "Controls hyper expansion characteristics"
msgstr "Hiperzabalkunde-ezaugarriak kontrolatzen ditu"

#: ../src/ui/widget/font-variations.cpp:126
msgid "Controls bounce/spring effect"
msgstr "Bote/malguki efektua kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:128
msgid "Controls informality characteristics"
msgstr "Informaltasun-ezaugarriak kontrolatzen ditu"

#: ../src/ui/widget/font-variations.cpp:130
msgid "Controls character spacing"
msgstr "Karaktere-tarteak kontrolatzen ditu"

#: ../src/ui/widget/font-variations.cpp:132
msgid "Controls negative spacing"
msgstr "Espazio negatiboa kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:134
msgid "Controls character 3D horizontal rotation"
msgstr "Karaktereen 3D biraketa horizontala kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:136
msgid "Controls character 3D vertical rotation"
msgstr "Karaktereen 3D biraketa bertikala kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:138
msgid "Controls sharpness characteristics"
msgstr "Zorroztasun-ezaugarriak kontrolatzen ditu"

#. TRANSLATORS: “Optical Size”
#. Optical sizes in a variable font are different versions of a typeface optimized for use at singular specific sizes,
#. such as 14 pt or 144 pt. Small (or body) optical sizes tend to have less stroke contrast, more open and wider spacing,
#. and a taller x-height than those of their large (or display) counterparts.
#: ../src/ui/widget/font-variations.cpp:147
msgid "Optimize the typeface for use at specific size"
msgstr "Optimizatu letra-tipoa tamaina jakin batekin erabiltzeko"

#. TRANSLATORS: Slant controls the font file’s slant parameter for oblique styles.
#: ../src/ui/widget/font-variations.cpp:149
msgid "Controls the font file’s slant parameter for oblique styles"
msgstr "Zeharkako estiloen letra-makurduraren parametroa kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:151
msgid "Turns on the font’s italic forms"
msgstr "Letra-tipoaren forma etzanak aktibatzen ditu"

#. TRANSLATORS: Weight controls the font file’s weight parameter.
#: ../src/ui/widget/font-variations.cpp:153
msgid "Controls the font file’s weight parameter"
msgstr "Letra-tipoaren pisua kontrolatzen du"

#. TRANSLATORS: Width controls the font file’s width parameter.
#: ../src/ui/widget/font-variations.cpp:155
msgid "Controls the font file’s width parameter"
msgstr "Letra-tipoaren zabalera kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:161
msgid "Controls the tabular width"
msgstr "Zabalera tabularra kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:162
msgid "Controls the weight of an underline"
msgstr "Azpimarraren pisua kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:163
msgid "Controls the depth of a shadow"
msgstr "Itzal baten sakonera kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:164
msgid "Controls the Y reflection"
msgstr "Y islapena kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:165

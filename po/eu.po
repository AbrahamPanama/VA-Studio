msgstr "Glifoaren unicodearen IDa kontrolatzen du"

#: ../src/ui/widget/font-variations.cpp:173
msgid "Controls the glyph’s feature variation"
msgstr "Glifoen ezaugarri-aldakuntza kontrolatzen du"


msgstr ""
"Nicht-destruktives Zerschneiden, Vereinigen, Differenz, Überschneidung und "
"Division eines Pfades mit einem anderen Pfad"

#: ../src/live_effects/effect.cpp:667
msgctxt "path effect"
msgid "Slice"
msgstr "Zerschneiden"


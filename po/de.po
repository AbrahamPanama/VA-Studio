msgstr "Erweitert den Pfad, optional unter Beibehaltung spitzer Ecken"

#: ../src/live_effects/effect.cpp:638
msgctxt "path effect"
msgid "Dashed Stroke"
msgstr "Gestrichelte Kontur"


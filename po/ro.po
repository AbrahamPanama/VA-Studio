msgstr "Lungime în stânga:"

#: ../src/live_effects/lpe-angle_bisector.cpp:46
#: ../src/live_effects/lpe-perp_bisector.cpp:92
msgid "Specifies the left end of the bisector"
msgstr "Specifică capătul stâng al bisectoarei"

#: ../src/live_effects/lpe-angle_bisector.cpp:47
#: ../src/live_effects/lpe-parallel.cpp:53
#: ../src/live_effects/lpe-perp_bisector.cpp:93
#: ../src/live_effects/lpe-tangent_to_curve.cpp:63
msgid "Length right:"
msgstr "Lungime în dreapta"

#: ../src/live_effects/lpe-angle_bisector.cpp:47
#: ../src/live_effects/lpe-perp_bisector.cpp:93
msgid "Specifies the right end of the bisector"
msgstr "Specifică capătul din dreapta al bisectoarei"

#: ../src/live_effects/lpe-angle_bisector.cpp:85
#: ../src/live_effects/lpe-perp_bisector.cpp:152
msgid "Adjust the \"left\" end of the bisector"
msgstr "Ajustează capătul din \"stânga\" al bisectoarei"

#: ../src/live_effects/lpe-angle_bisector.cpp:91
#: ../src/live_effects/lpe-perp_bisector.cpp:158
msgid "Adjust the \"right\" end of the bisector"
msgstr "Ajustează capătul din \"dreapta\" al bisectoarei"

#: ../src/live_effects/lpe-attach-path.cpp:24
msgid "Start path:"
msgstr "Începutul traseului:"

#: ../src/live_effects/lpe-attach-path.cpp:24
msgid "Path to attach to the start of this path"
msgstr "Traseul de atașat la începutul acestui traseu"

#: ../src/live_effects/lpe-attach-path.cpp:25
msgid "Start path position:"
msgstr "Poziția de început a traseului:"

#: ../src/live_effects/lpe-attach-path.cpp:25
msgid "Position to attach path start to"
msgstr "Poziția de atașare a începutului traseului"

#: ../src/live_effects/lpe-attach-path.cpp:26
msgid "Start path curve start:"
msgstr "Începutul primului traseu curb"

#: ../src/live_effects/lpe-attach-path.cpp:26
#: ../src/live_effects/lpe-attach-path.cpp:30
msgid "Starting curve"
msgstr "Curba de început"

#: ../src/live_effects/lpe-attach-path.cpp:27
msgid "Start path curve end:"
msgstr "Sfârșitul primului traseu curb"

#: ../src/live_effects/lpe-attach-path.cpp:27
#: ../src/live_effects/lpe-attach-path.cpp:31
msgid "Ending curve"
msgstr "Curba de sfârșit"

#: ../src/live_effects/lpe-attach-path.cpp:28
msgid "End path:"
msgstr "Traseul de sfârșit"

#: ../src/live_effects/lpe-attach-path.cpp:28
msgid "Path to attach to the end of this path"
msgstr "Traseul de atașat la sfârșitul acestui traseu"

#: ../src/live_effects/lpe-attach-path.cpp:29
msgid "End path position:"
msgstr "Poziția sfârșitului traseului"


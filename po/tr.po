msgstr "Süzgeç etkileri bölgesinin sol köşelerinin x koordinatı"

#: ../src/ui/dialog/filter-effects-dialog.cpp:3149
msgid "Y coordinate of the upper corners of filter effects region"
msgstr "Süzgeç etkileri bölgesinin üst köşelerinin y koordinatı"

#: ../src/ui/dialog/filter-effects-dialog.cpp:3150
msgid "Dimensions:"
msgstr "Boyutlar:"

#: ../src/ui/dialog/filter-effects-dialog.cpp:3150
msgid "Width of filter effects region"
msgstr "Süzgeç etkileri bölgesinin genişliği"

#: ../src/ui/dialog/filter-effects-dialog.cpp:3150
msgid "Height of filter effects region"
msgstr "Süzgeç etkileri bölgesinin yüksekliği"

#: ../src/ui/dialog/filter-effects-dialog.cpp:3157
msgid ""
"Indicates the type of matrix operation. The keyword 'matrix' indicates that "
"a full 5x4 matrix of values will be provided. The other keywords represent "
"convenience shortcuts to allow commonly used color operations to be "
"performed without specifying a complete matrix."
msgstr ""
"Matris işleminin türünü belirler. 'Matrix' anahtar sözcüğü, 5x4 değerlik bir "
"tam matrisin sağlanacağını belirler. Diğer anahtar sözcükler, yaygın bir "
"şekilde kullanılan renk işlemlerinin eksiksiz bir matris belirtilmeden "
"yapılmasını sağlayan kolaylık kısayollarını gösterir."


msgid ""
"Add dimensioning for distances between nodes, optionally with projection and "
"many other configuration options"
msgstr ""
"İsteğe bağlı olarak izdüşüm ve yapılandırma seçenekleriyle, düğümler "
"arasındaki uzaklıklar için boyutlandırma ekler"

#: ../src/live_effects/effect.cpp:568
msgctxt "path effect"
msgid "Corners"
msgstr "Köşeler"

#: ../src/live_effects/effect.cpp:571
msgid ""

msgctxt "Action Section"
msgid "Text"
msgstr "Κείμενο"

#: ../src/actions/actions-text.cpp:75
msgid "Put on Path"
msgstr "Τοποθέτηση σε μονοπάτι"

#
#: ../src/actions/actions-text.cpp:75
msgid "Put text on path"
msgstr "Τοποθέτηση κειμένου σε μονοπάτι"

#: ../src/actions/actions-text.cpp:76
msgid "Remove from Path"
msgstr "Αφαίρεση από μονοπάτι"


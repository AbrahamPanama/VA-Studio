msgid "Gouache"
msgstr "Κομμιογραφία"

#: ../build/share/filters/filters.svg.h:496
msgid "Partly opaque water color effect with bleed"
msgstr "Επίδραση μερικώς αδιαφανούς νερομπογιάς με διαρροή"


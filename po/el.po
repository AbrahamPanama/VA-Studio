msgid "Riddled"
msgstr "Κοσκινισμένο"

#: ../build/share/filters/filters.svg.h:536
msgid "Riddle the surface and add bump to images"
msgstr "Κοσκίνισμα της επιφάνειας και προσθήκη ανάγλυφου στις εικόνες"


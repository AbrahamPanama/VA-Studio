#: ../build/share/filters/filters.svg.h:486
msgid "Plaster"
msgstr "Σοβάς"

#: ../build/share/filters/filters.svg.h:488
msgid ""
"Combine a HSL edges detection bump with a matte and crumpled surface effect"
msgstr ""
"Συνδυασμός του ανάγλυφου ανίχνευσης άκρων HSL με την επίδραση μιας αστιλβούς "
"και ζαρωμένης επιφάνειας"

#: ../build/share/filters/filters.svg.h:490
msgid "Rough Transparency"
msgstr "Σκληρή διαφάνεια"


#: ../src/ui/tools/text-tool.cpp:1825 ../src/ui/tools/tool-data.cpp:62
msgid ""
"<b>Click</b> to select or create text, <b>drag</b> to create flowed text; "
"then type."
msgstr ""
"<b>Клик</b> за избор или прављење текста, <b>повуците</b> за прављење "
"уклопљеног текста; потом куцајте текст."

#: ../src/ui/tools/tool-base.cpp:662
msgid "<b>Space+mouse move</b> to pan canvas"
msgstr "<b>Размакница+померање мишеа</b> за померање платна"

#: ../src/ui/tools/tool-data.cpp:49
msgid ""
"<b>Click</b> to Select and Transform objects, <b>Drag</b> to select many "
"objects."
msgstr ""
"<b>Кликните</b> да изаберете и трансформишете објекте, <b>превуците</b> да "
"изаберете више објеката."

#: ../src/ui/tools/tool-data.cpp:50
msgid "Modify selected path points (nodes) directly."
msgstr "Директна промена изабраних тачака криве (чворова)."

#: ../src/ui/tools/tool-data.cpp:51
msgid "Construct shapes with the interactive Boolean tool."
msgstr "Конструисање облика интерактивном Буловом алатком."

#: ../src/ui/tools/tool-data.cpp:52
msgid ""
"<b>Drag</b> to create a rectangle. <b>Drag controls</b> to round corners and "
"resize. <b>Click</b> to select."
msgstr ""
"<b>Вуците</b> за цртање правоугаоника. <b>Вуците квачице</b> да заоблите "
"углове и промените величину. <b>Клик</b> за избор."

#: ../src/ui/tools/tool-data.cpp:53
msgid ""
"<b>Drag</b> to create an ellipse. <b>Drag controls</b> to make an arc or "
"segment. <b>Click</b> to select."
msgstr ""
"<b>Вуците</b> за цртање елипсе. <b>Вуците ручке</b> за прављење лука или "
"сегмента. <b>Клик</b> за избор."

#: ../src/ui/tools/tool-data.cpp:54
msgid ""
"<b>Drag</b> to create a star. <b>Drag controls</b> to edit the star shape. "
"<b>Click</b> to select."
msgstr ""
"<b>Вуците</b> за цртање звезде. <b>Вуците ручке</b> за уређивање облика "
"звезде. <b>Клик</b> за избор."

#: ../src/ui/tools/tool-data.cpp:55
msgid ""
"<b>Drag</b> to create a 3D box. <b>Drag controls</b> to resize in "
"perspective. <b>Click</b> to select (with <b>Ctrl+Alt</b> for single faces)."
msgstr ""
"<b>Вуците</b> за цртање 3Д кутије. <b>Вуците ручке</b> за промену величине у "
"перспективи. <b>Клик</b> за избор (са <b>Ctrl+Alt</b> за једну страну)."

#: ../src/ui/tools/tool-data.cpp:56
msgid ""
"<b>Drag</b> to create a spiral. <b>Drag controls</b> to edit the spiral "
"shape. <b>Click</b> to select."
msgstr ""
"<b>Вуците</b> за цртање спирале. <b>Вуците ручке</b> за уређивање облика "
"спирале. <b>Клик</b> за избор."

#: ../src/ui/tools/tool-data.cpp:57
msgid ""
"<b>Click</b> a shape to start editing its markers. <b>Drag controls</b> to "
"change orientation, scale, and position."
msgstr ""
"<b>Клик</b> на облик да започнете уређивање његових маркера. <b>Вуците "
"ручке</b> да промените оријентацију, величину, и позицију."

#: ../src/ui/tools/tool-data.cpp:58
msgid ""
"<b>Drag</b> to create a freehand line. <b>Shift</b> appends to selected "
"path, <b>Alt</b> activates sketch mode."
msgstr ""
"<b>Вуците</b> за креирање линије слободном руком. <b>Shift</b> за наставак "
"изабране линије, <b>Alt</b> укључује режим цртања."

#: ../src/ui/tools/tool-data.cpp:59
msgid ""
"<b>Click</b> or <b>click and drag</b> to start a path; with <b>Shift</b> to "
"append to selected path. <b>Ctrl+click</b> to create single dots (straight "
"line modes only)."
msgstr ""
"<b>Клик</b> или <b>клик са повлачењем</b> започиње линију; са <b>Shift</b> "
"за наставак изабране линије. <b>Ctrl+клик</b> прави појединачне тачке (само "
"у режиму праве)."

#: ../src/ui/tools/tool-data.cpp:60
#, fuzzy
#| msgid ""
#| "<b>Drag</b> to draw a calligraphic stroke; with <b>Ctrl</b> to track a "
#| "guide path. <b>Arrow keys</b> adjust width (left/right) and angle (up/"
#| "down)."
msgid ""
"<b>Drag</b> to draw a calligraphic stroke; with <b>%1</b> to track a guide "
"path. <b>Arrow keys</b> adjust width (left/right) and angle (up/down)."
msgstr ""
"<b>Вуците</b> за цртање калиграфске линије; са <b>Ctrl</b> за праћење "
"вођице. <b>Стрелице</b> подешавају ширину (лево/десно) и угао (горе/доле)."

#: ../src/ui/tools/tool-data.cpp:63
msgid ""
"<b>Drag</b> or <b>double click</b> to create a gradient on selected objects, "
"<b>drag handles</b> to adjust gradients."
msgstr ""
"<b>Вуците</b> или <b>двокликните</b> за креирање прелива на изабраним "
"објектима, <b>вуците ручке</b> за подешавање прелива."

#: ../src/ui/tools/tool-data.cpp:64
msgid ""
"<b>Drag</b> or <b>double click</b> to create a mesh on selected objects, "
"<b>drag handles</b> to adjust meshes."
msgstr ""
"<b>Вуците</b> или <b>двокликните</b> за прављење мреже на изабраним "
"објектима, <b>вуците ручке</b> за подешавање мреже."

#: ../src/ui/tools/tool-data.cpp:65
#, fuzzy
#| msgid ""
#| "<b>Click</b> or <b>drag around an area</b> to zoom in, <b>Shift+click</b> "
#| "to zoom out."

# SPDX-License-Identifier: GPL-2.0-or-later
#
# VA Studio public release identity: decisions that belong to the owner.
# Every key must have a value before a public release; the release readiness
# check fails while any value is empty. Builds and exports work with empty
# values: documents then keep their neutral wording and the build uses neutral
# fallbacks (CMakeScripts/VACardsPublicIdentity.cmake).
#
# Format: KEY=VALUE, one per line, no quotes. CMake validates the characters.
# The legal wording these values produce is not final (LEGAL-CHECK).

# Product name shown to users, for example: VA Studio
VA_PUBLIC_PRODUCT_NAME=

# Legal holder of the copyright in the VA Studio changes, as it should appear in
# "VA Studio (c) <holder>; based on Inkscape (c) Inkscape developers".
# ASCII letters, digits, spaces and . , & ( ) + ' - only (it is also written into
# the Windows version resource). It may start with a year, e.g. 2026 VA Cards.
VA_COPYRIGHT_HOLDER=

# https URL where users report problems and get help. Used by the crash dialog,
# the crash message on stderr and (after the src/actions change recorded in the
# release plan) Help > Report a problem. Until set, they point to the installed
# SUPPORT.md instead.
VA_SUPPORT_URL=

# https URL where the complete corresponding source of each release is offered
# (see share/doc/SOURCE.md).
VA_SOURCE_URL=

# https URL of the public source repository.
VA_PUBLIC_REPO_URL=

# Base URL under which the forked components are published. In the flattened
# public repository the forks are part of the repository itself; then set this
# to the public repository URL.
VA_FORKS_BASE_URL=

# Redistribution status of the TIFF export profile TheBest.icc, one of:
#   permission-recorded:<where the written permission is kept>
#   replaced:<file name of a redistributable replacement profile>
#   removed
VA_ICC_PROFILE_STATUS=

+/*
+ * Default (non-DComp) GDI path.
+ *
+ * Draws into the image renderer view of the reusable ARGB32 DIB owned by this
+ * context instead of creating a fresh display surface per frame.  Only the
+ * damaged physical-pixel rectangles are copied to the window DC in end_frame.
+ * This deliberately targets the image backend so drawing does not go through
+ * the Win32 GDI compositor dispatch.
+ */
+static void
+gdk_win32_cairo_context_begin_frame_gdi (GdkDrawContext  *draw_context,
+                                         gpointer         context_data,
+                                         GdkMemoryDepth   depth,
+                                         cairo_region_t  *region,
+                                         GdkColorState  **out_color_state,
+                                         GdkMemoryDepth  *out_depth)
+{
+  GdkWin32CairoContext *self = GDK_WIN32_CAIRO_CONTEXT (draw_context);
+  GdkSurface *surface = gdk_draw_context_get_surface (draw_context);
+  cairo_surface_t *image;
+  guint width, height;
+  double scale;
+  cairo_t *cr;
+  RECT client;
+  guint align;
+  gint64 client_width, client_height;
+  gboolean full = FALSE;
+
+  /* gdk_draw_context_begin_frame_full() asserts both of these after this
+   * callback returns, including on the failure paths, so set them before
+   * anything can bail out. */
+  *out_color_state = GDK_COLOR_STATE_SRGB;
+  *out_depth = gdk_color_state_get_depth (GDK_COLOR_STATE_SRGB);
+
+  /* Drop any surface left over from an earlier frame before reusing or
+   * replacing the backing storage. */
+  gdk_win32_cairo_context_gdi_frame_clear (self);
+
+  if (gdk_win32_cairo_context_gdi_buffer_disabled ())
+    {
+      gdk_win32_cairo_context_gdi_use_legacy (self, draw_context, context_data,
+                                              depth, region,
+                                              out_color_state, out_depth);
+      return;
+    }
+
+  gdk_draw_context_get_buffer_size (draw_context, &width, &height);
+  /* Buffer dimensions and the client rect are physical pixels. Win32 supplies
+   * an integer scale through the double API. Allow one alignment step at most. */
+  scale = gdk_surface_get_scale (surface);
+  if (!(scale > 0.0 && scale <= G_MAXUINT))
+    {
+      if (!self->gdi_alloc_failed)
+        g_warning ("GDK-WIN32: scale unavailable; using per-frame fallback");
+      self->gdi_alloc_failed = TRUE;
+      gdk_win32_cairo_context_gdi_use_legacy (self, draw_context, context_data,
+                                              depth, region, out_color_state, out_depth);
+      return;
+    }
+  if (GetClientRect (gdk_win32_surface_get_handle (surface), &client))
+    {
+      align = MAX (1u, (guint) ceil (scale));
+      client_width = (gint64) client.right - client.left;
+      client_height = (gint64) client.bottom - client.top;
+      if (client_width <= 0 || client_height <= 0)
+        width = height = 0;
+      else
+        {
+          guint64 bound_width = ((guint64) client_width + align - 1) / align * align;
+          guint64 bound_height = ((guint64) client_height + align - 1) / align * align;
+          width = MIN (width, (guint) MIN (bound_width, G_MAXINT));
+          height = MIN (height, (guint) MIN (bound_height, G_MAXINT));
+        }
+    }
+
+  if (self->gdi_attempt_width != width ||
+      self->gdi_attempt_height != height || self->gdi_attempt_scale != scale)
+    {
+      gdk_win32_cairo_context_gdi_cancel_retry (self);
+      g_clear_pointer (&self->gdi_pending, cairo_region_destroy);
+      self->gdi_alloc_failed = self->gdi_alloc_warned = self->gdi_transfer_warned = FALSE;
+      self->gdi_attempt_width = width;
+      self->gdi_attempt_height = height;
+      self->gdi_attempt_scale = scale;
+      gdk_win32_cairo_context_gdi_buffer_clear (self, TRUE);
+    }
+
+  if (width == 0 || height == 0)
+    {
+      /* Minimized/empty: allocate no pixel backing and force a full repaint
+       * later.  A zero-size image surface is a valid placeholder. */
+      gdk_win32_cairo_context_gdi_buffer_clear (self, TRUE);
+      self->cairo_surface = gdk_win32_cairo_context_gdi_empty_surface ();
+      return;
+    }
+
+  if (self->gdi_alloc_failed)
+    {
+      gdk_win32_cairo_context_gdi_use_legacy (self, draw_context, context_data,
+                                              depth, region, out_color_state, out_depth);
+      return;
+    }
+
+  if (self->gdi_buffer == NULL ||
+      cairo_surface_status (self->gdi_buffer) != CAIRO_STATUS_SUCCESS ||
+      self->gdi_buffer_width != width ||
+      self->gdi_buffer_height != height ||
+      self->gdi_buffer_scale != scale)
+    {
+      gdk_win32_cairo_context_gdi_buffer_clear (self, TRUE);
+
+      self->gdi_buffer = gdk_win32_cairo_context_gdi_fault (TRUE) ? NULL :
+        cairo_win32_surface_create_with_dib (CAIRO_FORMAT_ARGB32,
+                                              width, height);
+      if (self->gdi_buffer == NULL ||
+          cairo_surface_status (self->gdi_buffer) != CAIRO_STATUS_SUCCESS)
+        {
+          self->gdi_alloc_failed = TRUE;
+          if (!self->gdi_alloc_warned)
+            g_warning ("GDK-WIN32: could not allocate a %ux%u reusable GDI "
+                       "backing store (%s); using the per-frame fallback",
+                       width,
+                       height,
+                       self->gdi_buffer != NULL
+                         ? cairo_status_to_string (cairo_surface_status (self->gdi_buffer))
+                         : "out of memory");
+          self->gdi_alloc_warned = TRUE;
+          gdk_win32_cairo_context_gdi_use_legacy (self, draw_context,
+                                                  context_data, depth, region,
+                                                  out_color_state, out_depth);
+          return;
+        }
+
+      self->gdi_buffer_width = width;
+      self->gdi_buffer_height = height;
+      self->gdi_buffer_scale = scale;
+      self->gdi_buffer_valid = FALSE;
+    }
+
+  if (!self->gdi_buffer_valid)
+    full = TRUE;
+
+  /* cairo_win32_surface_get_image() returns the image surface that shares the
+   * DIB bits; it is owned by gdi_buffer.  Validate it and take our own
+   * reference for the duration of the frame so the image renderer is used
+   * directly and the view cannot be torn down under us. */
+  image = cairo_win32_surface_get_image (self->gdi_buffer);
+  if (image == NULL ||
+      cairo_surface_status (image) != CAIRO_STATUS_SUCCESS ||
+      cairo_surface_get_type (image) != CAIRO_SURFACE_TYPE_IMAGE)
+    {
+      self->gdi_alloc_failed = TRUE;
+      if (!self->gdi_alloc_warned)
+        g_warning ("GDK-WIN32: reusable GDI backing store has no valid image "
+                   "view; using the per-frame fallback");
+      self->gdi_alloc_warned = TRUE;
+      gdk_win32_cairo_context_gdi_use_legacy (self, draw_context, context_data,
+                                              depth, region,
+                                              out_color_state, out_depth);
+      return;
+    }
+
+  self->gdi_frame_image = cairo_surface_reference (image);
+  self->cairo_surface = self->gdi_frame_image;
+
+  /* The renderer only repaints what it is told is damaged, so a backing store
+   * without trustworthy content must expand the received physical-pixel
+   * region to the full buffer before the region is used for clipping. */
+  if (full)
+    cairo_region_union_rectangle (region,
+                                  &(cairo_rectangle_int_t) {
+                                      0, 0, width, height
+                                  });
+
+  cr = cairo_create (self->cairo_surface);
+  cairo_set_operator (cr, CAIRO_OPERATOR_CLEAR);
+  gdk_cairo_region (cr, region);
+  cairo_fill (cr);
+
+  /* If the clear could not be recorded, keep the buffer marked invalid so the
+   * next frame is fully repainted instead of trusting stale pixels. */
+  self->gdi_buffer_valid = cairo_status (cr) == CAIRO_STATUS_SUCCESS;
+  cairo_destroy (cr);
+}

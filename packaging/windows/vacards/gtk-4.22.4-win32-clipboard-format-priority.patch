+/* The ANSI code page CF_TEXT data was written in: the one of the CF_LOCALE
+ * format that Windows keeps next to it, if present. The process code page can
+ * differ (e.g. an application manifest that selects UTF-8). Falls back to
+ * CP_ACP. Only meaningful while the clipboard is open in this thread, which is
+ * the case when retrieving clipboard data; otherwise GetClipboardData fails
+ * and the fallback applies (e.g. for drag and drop data). */
+static UINT
+get_cf_text_codepage (void)
+{
+  UINT codepage = CP_ACP;
+  HANDLE hlocale;
+  const LCID *lcid;
+  DWORD ansi_cp = 0;
+
+  if (!IsClipboardFormatAvailable (CF_LOCALE))
+    return codepage;
+
+  hlocale = GetClipboardData (CF_LOCALE);
+  if (hlocale == NULL)
+    return codepage;
+
+  if (GlobalSize (hlocale) >= sizeof (LCID) &&
+      (lcid = GlobalLock (hlocale)) != NULL)
+    {
+      if (GetLocaleInfoW (*lcid,
+                          LOCALE_IDEFAULTANSICODEPAGE | LOCALE_RETURN_NUMBER,
+                          (LPWSTR) &ansi_cp,
+                          sizeof (ansi_cp) / sizeof (WCHAR)) > 0 &&
+          ansi_cp != 0 &&
+          IsValidCodePage ((UINT) ansi_cp))
+        codepage = (UINT) ansi_cp;
+
+      GlobalUnlock (hlocale);
+    }
+
+  return codepage;
+}

+void RVNGSVGDrawingGeneratorTextTest::testEscapingInMarkedText()
+{
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("center"));
+		RVNGPropertyList s;
+		s.insert("fo:font-size", 12.0, RVNG_POINT);
+		s.insert("style:font-name", "DejaVu <Sans> & \"Test\"");
+		s.insert("fo:font-style", "italic\" onload=\"x");
+		s.insert("fo:font-weight", "bold&<>");
+		s.insert("fo:color", "#fff\"&");
+		gen.openSpan(s);
+		gen.insertText("A < B & C > D \"q\"");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, "font-family=\"DejaVu &lt;Sans&gt; &amp; &quot;Test&quot;\""));
+	CPPUNIT_ASSERT(contains(svg, "font-style=\"italic&quot; onload=&quot;x\""));
+	CPPUNIT_ASSERT(contains(svg, "font-weight=\"bold&amp;&lt;&gt;\""));
+	CPPUNIT_ASSERT(contains(svg, "fill=\"#fff&quot;&amp;\""));
+	CPPUNIT_ASSERT(contains(svg, ">A &lt; B &amp; C &gt; D &quot;q&quot;</tspan>"));
+	CPPUNIT_ASSERT(!contains(svg, "font-family=\"DejaVu <Sans>"));
+	CPPUNIT_ASSERT(!contains(svg, "onload=\"x\""));
+}

+void RVNGSVGDrawingGeneratorCropTest::testXmlAttributeAndTextEscaping()
+{
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList text;
+		text.insert("svg:x", 1.0);
+		text.insert("svg:y", 1.0);
+		text.insert("svg:width", 2.0);
+		text.insert("svg:height", 1.0);
+		gen.startTextObject(text);
+		RVNGPropertyList para;
+		gen.openParagraph(para);
+		RVNGPropertyList span;
+		span.insert("fo:font-size", 12.0, RVNG_POINT);
+		span.insert("style:font-name", "DejaVu <Sans> & \"Test\"");
+		span.insert("fo:font-style", "italic\" onload=\"x");
+		span.insert("fo:font-weight", "bold&<>");
+		span.insert("fo:color", "#fff\"&");
+		gen.openSpan(span);
+		gen.insertText("A < B & C > D \"q\"");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, "font-family=\"DejaVu &lt;Sans&gt; &amp; &quot;Test&quot;\""));
+	CPPUNIT_ASSERT(contains(svg, "font-style=\"italic&quot; onload=&quot;x\""));
+	CPPUNIT_ASSERT(contains(svg, "font-weight=\"bold&amp;&lt;&gt;\""));
+	CPPUNIT_ASSERT(contains(svg, "fill=\"#fff&quot;&amp;\""));
+	CPPUNIT_ASSERT(contains(svg, "A &lt; B &amp; C &gt; D &quot;q&quot;"));
+	// no raw unescaped injection remains
+	CPPUNIT_ASSERT(!contains(svg, "font-family=\"DejaVu <Sans>"));
+	CPPUNIT_ASSERT(!contains(svg, "onload=\"x\""));
+}
+
+void RVNGSVGDrawingGeneratorCropTest::testMarkerWithoutBoundaryKeepsImage()
+{
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList img = makeCropImage();
+		// required crop-path absent: no boundary recorded, image stays valid
+		gen.drawGraphicObject(img);
+	});
+	CPPUNIT_ASSERT(!contains(svg, "clipPath"));
+	CPPUNIT_ASSERT(!contains(svg, "capability="));
+	CPPUNIT_ASSERT(contains(svg, kImageElement));
+}

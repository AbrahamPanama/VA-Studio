+void RVNGSVGDrawingGeneratorPrivate::writeSpanAttributes(const RVNGPropertyList &pList)
+{
+	if (pList["style:font-name"])
+		m_outputSink << "font-family=\"" << escapeXmlAttribute(pList["style:font-name"]->getStr()) << "\" ";
+	if (pList["fo:font-style"])
+		m_outputSink << "font-style=\"" << escapeXmlAttribute(pList["fo:font-style"]->getStr()) << "\" ";
+	if (pList["fo:font-weight"])
+		m_outputSink << "font-weight=\"" << escapeXmlAttribute(pList["fo:font-weight"]->getStr()) << "\" ";
+	if (pList["fo:font-variant"])
+		m_outputSink << "font-variant=\"" << escapeXmlAttribute(pList["fo:font-variant"]->getStr()) << "\" ";
+	if (pList["fo:font-size"])
+		m_outputSink << "font-size=\"" << doubleToString(pList["fo:font-size"]->getDouble()) << "\" ";
+	if (pList["fo:color"])
+		m_outputSink << "fill=\"" << escapeXmlAttribute(pList["fo:color"]->getStr()) << "\" ";
+	if (pList["fo:text-transform"])
+		m_outputSink << "text-transform=\"" << escapeXmlAttribute(pList["fo:text-transform"]->getStr()) << "\" ";
+	if (pList["svg:fill-opacity"])
+		m_outputSink << "fill-opacity=\"" << doubleToString(pList["svg:fill-opacity"]->getDouble()) << "\" ";
+	if (pList["svg:stroke-opacity"])
+		m_outputSink << "stroke-opacity=\"" << doubleToString(pList["svg:stroke-opacity"]->getDouble()) << "\" ";
+}

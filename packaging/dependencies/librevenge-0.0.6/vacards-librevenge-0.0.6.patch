+void RVNGSVGDrawingGeneratorCropTest::testVisibleFrameRoleSeparateDrawPath()
+{
+	// Approved decision: a `visible-frame` role boundary remains a separately
+	// emitted drawPath; the bitmap event must not synthesize a visible frame
+	// because it carries no complete stroke/fill style. The boundary on the
+	// bitmap event is still consumed as its clip.
+	//
+	// (a) The bitmap event alone is clipped and emits no styled frame: the only
+	// <path> is the boundary inside <defs>.
+	const std::string bitmapOnly = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList img = makeCropImage("parent", "nonzero", "visible-frame");
+		img.insert(kCropPath, rectanglePath());
+		gen.drawGraphicObject(img);
+	});
+	CPPUNIT_ASSERT(contains(bitmapOnly, "<clipPath id=\"cdrclip1\" clipPathUnits=\"userSpaceOnUse\">"));
+	CPPUNIT_ASSERT(contains(bitmapOnly, "<g clip-path=\"url(#cdrclip1)\">\n"));
+	CPPUNIT_ASSERT(contains(bitmapOnly, kImageElement));
+	CPPUNIT_ASSERT(bitmapOnly.find("stroke:") == std::string::npos);
+	CPPUNIT_ASSERT(bitmapOnly.find("fill:") == std::string::npos);
+	CPPUNIT_ASSERT(countOccurrences(bitmapOnly, "<path ") == 1);
+
+	// (b) The reader's independent visible frame (an ordinary drawPath event)
+	// survives next to the clip; the bitmap stays clipped.
+	const std::string withFrame = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList img = makeCropImage("parent", "nonzero", "visible-frame");
+		img.insert(kCropPath, rectanglePath());
+		gen.drawGraphicObject(img);
+
+		RVNGPropertyList style;
+		style.insert("draw:stroke", "solid");
+		style.insert("svg:stroke-color", "#00ff00");
+		style.insert("draw:fill", "none");
+		gen.setStyle(style);
+		RVNGPropertyListVector d;
+		RVNGPropertyList n;
+		n.insert("librevenge:path-action", "M"); n.insert("svg:x", 0.5); n.insert("svg:y", 0.5); d.append(n);
+		n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.0); n.insert("svg:y", 0.5); d.append(n);
+		n.clear(); n.insert("librevenge:path-action", "Z"); d.append(n);
+		RVNGPropertyList frame;
+		frame.insert("svg:d", d);
+		gen.drawPath(frame);
+	});
+	CPPUNIT_ASSERT(contains(withFrame, "<clipPath id=\"cdrclip1\""));
+	CPPUNIT_ASSERT(contains(withFrame, "<g clip-path=\"url(#cdrclip1)\">"));
+	CPPUNIT_ASSERT(contains(withFrame, kImageElement));
+	CPPUNIT_ASSERT(contains(withFrame, "</g>\n<path d=\" "));
+	CPPUNIT_ASSERT(contains(withFrame, "stroke: #00ff00;"));
+}

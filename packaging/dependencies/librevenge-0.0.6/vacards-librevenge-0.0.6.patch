+void RVNGSVGDrawingGeneratorTextTest::testMarkedSingleLineExact()
+{
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("Hello");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	const std::string expected =
+	    "<svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"4.0000in\" height=\"4.0000in\" viewBox=\"0 0 288.0000 288.0000\" >\n"
+	    "<text x=\"72.0000\" y=\"144.0000\" xml:space=\"preserve\">"
+	    "<tspan x=\"72.0000\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" >Hello</tspan>"
+	    "</text>\n"
+	    "</svg>\n\n";
+	CPPUNIT_ASSERT(expected == svg);
+}

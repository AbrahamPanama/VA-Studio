+void RVNGSVGDrawingGeneratorCropTest::testLeadingNonMovetoRefused()
+{
+	// SVG path data must begin with a moveto. A producer boundary whose first
+	// node is anything else must be refused with the existing malformed-crop-path
+	// notice and the image preserved unclipped, never emitted as invalid clipPath
+	// data (a leading lineto can silently blank the image).
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList img = makeCropImage();
+		RVNGPropertyListVector path;
+		RVNGPropertyList n;
+		n.insert("librevenge:path-action", "L"); n.insert("svg:x", 0.6); n.insert("svg:y", 0.8); path.append(n);
+		n.clear(); n.insert("librevenge:path-action", "M"); n.insert("svg:x", 1.1); n.insert("svg:y", 0.8); path.append(n);
+		n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.1); n.insert("svg:y", 1.4); path.append(n);
+		n.clear(); n.insert("librevenge:path-action", "Z"); path.append(n);
+		img.insert(kCropPath, path);
+		gen.drawGraphicObject(img);
+	});
+	CPPUNIT_ASSERT(contains(svg, "<!-- librevenge:cdr-crop capability=\"malformed-crop-path\""));
+	CPPUNIT_ASSERT(!contains(svg, "clipPath"));
+	// no invalid leading-lineto path data leaks into the document
+	CPPUNIT_ASSERT(!contains(svg, "d=\"\nL"));
+	CPPUNIT_ASSERT(contains(svg, kImageElement));
+}

+		img.insert(kCropPath, rectanglePath());
+		gen.drawGraphicObject(img);
+	});
+	CPPUNIT_ASSERT(contains(plain, "<path d=\"\nM43.2000,57.6000\nL79.2000,57.6000\nL79.2000,100.8000\nZ\" clip-rule=\"nonzero\" />"));
+	CPPUNIT_ASSERT(contains(rotated, "<path d=\"\nM43.2000,57.6000\nL79.2000,57.6000\nL79.2000,100.8000\nZ\" clip-rule=\"nonzero\" />"));
+	CPPUNIT_ASSERT(!contains(rotated, "transform=\"matrix("));
+	CPPUNIT_ASSERT(contains(rotated, "rotate(17.1455)"));
+	CPPUNIT_ASSERT(contains(rotated, "scale(-1, 1)"));
+}

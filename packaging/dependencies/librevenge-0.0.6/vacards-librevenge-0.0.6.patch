+		n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.5); n.insert("svg:y", 1.0); path.append(n);
+		n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.5); n.insert("svg:y", 1.5); path.append(n);
+		n.clear(); n.insert("librevenge:path-action", "Z"); path.append(n);
+		second.insert(kCropPath, path);
+		gen.drawGraphicObject(second);
+	});
+	CPPUNIT_ASSERT(contains(svg, "clipPath id=\"cdrclip1\""));
+	CPPUNIT_ASSERT(contains(svg, "clipPath id=\"cdrclip2\""));

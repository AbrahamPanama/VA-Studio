+		t.insert("fo:padding-right", 0.5);
+		gen.startTextObject(t);
+		gen.openParagraph(paragraph("center"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("X");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, "<text x=\"90.0000\" y=\"144.0000\" xml:space=\"preserve\">"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"135.0000\" text-anchor=\"middle\""));
+}

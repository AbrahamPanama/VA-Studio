+#include <cstddef>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace test
+{
+
+using namespace librevenge;
+
+namespace
+{
+
+const char *const kVersion = "vacards:cdr-fidelity-version";
+const char *const kObjectId = "vacards:cdr-object-id";
+const char *const kContentKind = "vacards:cdr-content-kind";
+const char *const kCropRole = "vacards:cdr-crop-role";
+const char *const kCropSpace = "vacards:cdr-crop-space";
+const char *const kCropFillRule = "vacards:cdr-crop-fill-rule";
+const char *const kCropPath = "vacards:cdr-crop-path";
+const char *const kImageTransform = "vacards:cdr-image-transform";
+
+//! Exact pre-patch (0.0.6) bytes for one unmarked PNG graphic object, captured
+//! from the unmodified generator before the C02 change. This is the strongest
+//! available byte-compatibility oracle for an unmarked stream.
+const char *const kLegacyImageSvg =
+    "<svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"4.0000in\" height=\"4.0000in\" viewBox=\"0 0 288.0000 288.0000\" >\n"
+    "<image x=\"36.0000\" y=\"54.0000\" width=\"144.0000\" height=\"108.0000\" xlink:href=\"data:image/png;base64,QUJD\" />\n"
+    "</svg>\n\n";
+
+const char *const kImageElement =
+    "<image x=\"36.0000\" y=\"54.0000\" width=\"144.0000\" height=\"108.0000\" xlink:href=\"data:image/png;base64,QUJD\" />";
+
+bool contains(const std::string &haystack, const std::string &needle)
+{
+	return haystack.find(needle) != std::string::npos;
+}
+
+std::size_t countOccurrences(const std::string &haystack, const std::string &needle)
+{
+	std::size_t count = 0, pos = 0;
+	while ((pos = haystack.find(needle, pos)) != std::string::npos)
+	{
+		++count;
+		pos += needle.size();
+	}
+	return count;
+}
+
+//! substring strictly between the first `open` at/after `from` and the next `close`
+std::string between(const std::string &text, const std::string &open, const std::string &close,
+                    std::size_t from = 0)
+{
+	const std::size_t begin = text.find(open, from);
+	if (begin == std::string::npos)
+		return std::string();
+	const std::size_t valueStart = begin + open.size();
+	const std::size_t end = text.find(close, valueStart);
+	if (end == std::string::npos)
+		return std::string();
+	return text.substr(valueStart, end - valueStart);
+}
+
+//! parse a comma/whitespace separated list of numbers
+std::vector<double> parseNumberList(std::string text)
+{
+	for (std::size_t i = 0; i < text.size(); ++i)
+		if (text[i] == ',')
+			text[i] = ' ';
+	std::vector<double> values;
+	std::istringstream stream(text);
+	double value = 0.0;
+	while (stream >> value)
+		values.push_back(value);
+	return values;
+}
+
+RVNGPropertyList makeImage()
+{
+	RVNGPropertyList img;
+	img.insert("librevenge:mime-type", "image/png");
+	const unsigned char payload[] = { 'A', 'B', 'C' };
+	img.insert("office:binary-data", payload, 3);
+	img.insert("svg:x", 0.5);
+	img.insert("svg:y", 0.75);
+	img.insert("svg:width", 2.0);
+	img.insert("svg:height", 1.5);
+	return img;
+}
+
+RVNGPropertyList makeCropImage(const char *space = "parent",
+                               const char *rule = "nonzero",
+                               const char *role = "crop-only")
+{
+	RVNGPropertyList img = makeImage();
+	img.insert(kVersion, 1);
+	img.insert(kContentKind, "bitmap");
+	img.insert(kObjectId, 11);
+	img.insert(kCropRole, role);
+	img.insert(kCropSpace, space);
+	img.insert(kCropFillRule, rule);
+	return img;
+}
+
+//! one closed rectangular subpath, in inches
+RVNGPropertyListVector rectanglePath()
+{
+	RVNGPropertyListVector path;
+	RVNGPropertyList n;
+	n.insert("librevenge:path-action", "M"); n.insert("svg:x", 0.6); n.insert("svg:y", 0.8); path.append(n);
+	n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.1); n.insert("svg:y", 0.8); path.append(n);
+	n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.1); n.insert("svg:y", 1.4); path.append(n);
+	n.clear(); n.insert("librevenge:path-action", "Z"); path.append(n);
+	return path;
+}
+
+RVNGPropertyListVector twoSubpaths()
+{
+	RVNGPropertyListVector path = rectanglePath();
+	RVNGPropertyList n;
+	n.insert("librevenge:path-action", "M"); n.insert("svg:x", 0.7); n.insert("svg:y", 0.9); path.append(n);
+	n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.0); n.insert("svg:y", 0.9); path.append(n);
+	n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.0); n.insert("svg:y", 1.2); path.append(n);
+	n.clear(); n.insert("librevenge:path-action", "Z"); path.append(n);
+	return path;
+}
+
+RVNGPropertyListVector matrixPath(const double m[6])
+{
+	RVNGPropertyListVector xform;
+	for (int i = 0; i < 6; ++i)
+	{
+		// vector order is the contract: the six entries are [a b c d e f]
+		RVNGPropertyList n;
+		n.insert("vacards:cdr-matrix-value", m[i]);
+		xform.append(n);
+	}
+	return xform;
+}
+
+template <class F>
+std::string emit(F fill)
+{
+	RVNGStringVector out;
+	RVNGSVGDrawingGenerator gen(out, "");
+	RVNGPropertyList doc;
+	gen.startDocument(doc);
+	RVNGPropertyList page;
+	page.insert("svg:width", 4.0);
+	page.insert("svg:height", 4.0);
+	gen.startPage(page);
+	fill(gen);
+	gen.endPage();
+	gen.endDocument();
+	std::string all;
+	for (unsigned i = 0; i < out.size(); ++i)
+	{
+		all += out[i].cstr();
+		all += "\n";
+	}
+	return all;
+}
+

+void RVNGSVGDrawingGeneratorPrivate::drawVersionedCropGraphicObject(const RVNGPropertyList &propList, int version)
+{
+	if (version != 1)
+	{
+		writeCapabilityNotice("unsupported-version", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	if (getStringValue(propList, cdrContentKind) != "bitmap")
+	{
+		writeCapabilityNotice("unsupported-content-kind", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	if (!propList[cdrObjectId] || propList[cdrObjectId]->getUnit() == RVNG_UNIT_ERROR)
+	{
+		writeCapabilityNotice("malformed-object-id", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	const std::string role = getStringValue(propList, cdrCropRole);
+	if (role != "crop-only" && role != "visible-frame")
+	{
+		writeCapabilityNotice("unsupported-crop-role", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	if (role == "visible-frame")
+		RVNG_DEBUG_MSG(("RVNGSVGDrawingGenerator: CDR crop boundary is an independently visible frame\n"));
+	const std::string space = getStringValue(propList, cdrCropSpace);
+	if (space != "parent" && space != "image")
+	{
+		writeCapabilityNotice("unsupported-crop-space", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	const std::string rule = getStringValue(propList, cdrCropFillRule);
+	if (rule != "unspecified" && rule != "nonzero" && rule != "evenodd")
+	{
+		writeCapabilityNotice("unsupported-crop-fill-rule", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	const RVNGPropertyListVector *path = propList.child(cdrCropPath);
+	if (!path || path->count() == 0)
+	{
+		// no boundary recorded: keep the image valid and unclipped
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	std::string matrix;
+	if (space == "image" && !getImageTransformMatrix(propList, matrix))
+	{
+		writeCapabilityNotice("malformed-image-transform", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	std::string pathData;
+	unsigned long subpathCount = 0;
+	if (!serializeCropPath(*path, pathData, subpathCount))
+	{
+		writeCapabilityNotice("malformed-crop-path", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+	if (rule == "unspecified" && subpathCount > 1)
+	{
+		// Compound holes cannot be proven from the producer field: refuse to guess.
+		writeCapabilityNotice("unspecified-compound-fill-rule", propList);
+		writeGraphicObjectImage(propList);
+		return;
+	}
+
+	const int clipId = m_cropClipIndex++;
+	m_outputSink << "<" << getNamespaceAndDelim() << "defs>\n";
+	m_outputSink << "<" << getNamespaceAndDelim() << "clipPath id=\"cdrclip" << clipId
+	             << "\" clipPathUnits=\"userSpaceOnUse\"";
+	if (!matrix.empty())
+		m_outputSink << " transform=\"" << matrix << "\"";
+	m_outputSink << ">\n";
+	m_outputSink << "<" << getNamespaceAndDelim() << "path d=\"" << pathData << "\"";
+	if (rule == "nonzero" || rule == "evenodd")
+		m_outputSink << " clip-rule=\"" << rule << "\"";
+	m_outputSink << " />\n";
+	m_outputSink << "</" << getNamespaceAndDelim() << "clipPath>\n";
+	m_outputSink << "</" << getNamespaceAndDelim() << "defs>\n";
+	m_outputSink << "<" << getNamespaceAndDelim() << "g clip-path=\"url(#cdrclip" << clipId << ")\">\n";
+	writeGraphicObjectImage(propList);
+	m_outputSink << "</" << getNamespaceAndDelim() << "g>\n";
+}

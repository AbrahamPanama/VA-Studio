+void RVNGSVGDrawingGeneratorTextTest::testJustifyFallsBackToStart()
+{
+	// SVG has no justified anchor and the transport carries no per-line width
+	// metric, so `justify`/`full` are anchored at start (documented fallback);
+	// no per-line textLength or custom line breaker is invented.
+	const std::string justify = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("justify"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("a b c");
+		gen.insertLineBreak();
+		gen.insertText("d e");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(justify, "<tspan x=\"72.0000\" text-anchor=\"start\""));
+	CPPUNIT_ASSERT(contains(justify, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\""));
+	CPPUNIT_ASSERT(!contains(justify, "textLength"));
+	CPPUNIT_ASSERT(!contains(justify, "text-anchor=\"middle\""));
+}

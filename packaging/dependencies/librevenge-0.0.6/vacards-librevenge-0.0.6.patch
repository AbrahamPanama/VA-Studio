+void RVNGSVGDrawingGeneratorTextTest::testAlignmentAnchors()
+{
+	// left -> start@left edge, center -> middle@center, end/right -> end@right.
+	struct Case
+	{
+		const char *align;
+		const char *anchor;
+		const char *x;
+	};
+	const Case cases[] =
+	{
+		{ "left",  "start",  "72.0000" },
+		{ "center","middle", "144.0000" },
+		{ "end",   "end",    "216.0000" },
+		{ "right", "end",    "216.0000" },
+		{ 0,       "start",  "72.0000" } // no fo:text-align -> left default
+	};
+	for (std::size_t i = 0; i < sizeof(cases)/sizeof(cases[0]); ++i)
+	{
+		const Case &c = cases[i];
+		const std::string svg = emit([&c](RVNGSVGDrawingGenerator &gen)
+		{
+			gen.startTextObject(markedFrame());
+			gen.openParagraph(paragraph(c.align));
+			gen.openSpan(style("Lora", 12.0));
+			gen.insertText("X");
+			gen.closeSpan();
+			gen.closeParagraph();
+			gen.endTextObject();
+		});
+		const std::string expected = std::string("<tspan x=\"") + c.x +
+		                             "\" text-anchor=\"" + c.anchor + "\"";
+		CPPUNIT_ASSERT(contains(svg, expected));
+		CPPUNIT_ASSERT_EQUAL(std::size_t(1), countOccurrences(svg, "text-anchor="));
+	}
+}

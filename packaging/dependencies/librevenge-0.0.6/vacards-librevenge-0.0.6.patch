+//! A resolved span style plus the characters inserted under it. The style is a
+//! deep copy of the resolved openSpan property list so it survives the
+//! synchronous draw call (contract section 6).
+struct TextRun
+{
+	RVNGPropertyList style;
+	std::string text;
+};
+
+//! One hard-break delimited line. `insertLineBreak()` starts a new TextLine;
+//! consecutive breaks therefore produce consecutive (empty) lines.
+struct TextLine
+{
+	std::vector<TextRun> runs;
+	//! Span style basis for this line. It is the active span style when one is
+	//! open, otherwise the style of the most recent non-empty run (so a blank
+	//! line created after closeSpan still resolves its dy="1.2em" against the
+	//! adjacent run's font-size). Only used for blank lines. Empty when neither
+	//! an active span nor a prior non-empty run style exists (D2 / T01-FIX2).
+	RVNGPropertyList styleBasis;
+};
+
+//! One `openParagraph()`/`closeParagraph()` pair. The alignment is captured
+//! from `fo:text-align` and mapped to an SVG text-anchor plus anchor position.
+struct TextParagraph
+{
+	std::string align;
+	std::vector<TextLine> lines;
+};

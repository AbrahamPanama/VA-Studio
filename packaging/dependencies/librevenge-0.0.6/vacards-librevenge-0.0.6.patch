+void RVNGSVGDrawingGeneratorTextTest::testSpanIdResolutionInMarkedText()
+{
+	// defineCharacterStyle + span-id resolution must still feed the buffered run
+	// (existing SVG generator state is reused, not reimplemented).
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		RVNGPropertyList named;
+		named.insert("librevenge:span-id", 7);
+		named.insert("fo:font-size", 18.0, RVNG_POINT);
+		named.insert("style:font-name", "Lora");
+		gen.defineCharacterStyle(named);
+		RVNGPropertyList reference;
+		reference.insert("librevenge:span-id", 7);
+		gen.openSpan(reference);
+		gen.insertText("styled");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"18.0000\" >styled</tspan>"));
+}

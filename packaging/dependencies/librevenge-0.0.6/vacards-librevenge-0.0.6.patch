+void RVNGSVGDrawingGeneratorTextTest::testUnequalLineLengthsAndLineCount()
+{
+	// One span spanning three hard breaks: the generator must open a new
+	// positioned line for each break and keep the same run style.
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("center"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("short");
+		gen.insertLineBreak();
+		gen.insertText("a much longer second line");
+		gen.insertLineBreak();
+		gen.insertText("mid");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+
+	// Exact line strings, in order and on their own positioned tspan.
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"144.0000\" text-anchor=\"middle\" font-family=\"Lora\" font-size=\"12.0000\" >short</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"144.0000\" dy=\"1.2em\" text-anchor=\"middle\" font-family=\"Lora\" font-size=\"12.0000\" >a much longer second line</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"144.0000\" dy=\"1.2em\" text-anchor=\"middle\" font-family=\"Lora\" font-size=\"12.0000\" >mid</tspan>"));
+
+	// Three lines => three anchored lines and two advances.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(3), countOccurrences(svg, "text-anchor=\"middle\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "dy=\"1.2em\""));
+	// Center anchor position, not the legacy left edge.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(3), countOccurrences(svg, "x=\"144.0000\""));
+	CPPUNIT_ASSERT(!contains(svg, "x=\"72.0000\" text-anchor"));
+}
+
+void RVNGSVGDrawingGeneratorTextTest::testInitialAndInteriorBlankLines()
+{
+	// Line 0 blank, line 1 text, line 2 blank, line 3 text.
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertLineBreak();
+		gen.insertText("after initial");
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.insertText("after interior");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	// Blank lines carry the active Lora/12pt style basis so their dy=1.2em
+	// resolves against the same font-size as the adjacent runs (D2).
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" />"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" >after initial</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" />"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" >after interior</tspan>"));
+	// four lines: four anchors, three advances, two of them blank
+	CPPUNIT_ASSERT_EQUAL(std::size_t(4), countOccurrences(svg, "text-anchor=\"start\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(3), countOccurrences(svg, "dy=\"1.2em\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "font-size=\"12.0000\" />"));
+	// No blank line is collapse-to-whitespace or drops to the inherited size.
+	CPPUNIT_ASSERT(!contains(svg, "text-anchor=\"start\" />"));
+}
+
+void RVNGSVGDrawingGeneratorTextTest::testBlankLineCarriesActiveFontSize()
+{
+	// A blank line between two 18pt runs must be emitted with the same 18pt
+	// font-size basis, otherwise its dy=1.2em would resolve against the
+	// inherited UA size instead of the adjacent runs (D2).
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 18.0));
+		gen.insertText("first");
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.insertText("second");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"18.0000\" >first</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"18.0000\" />"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"18.0000\" >second</tspan>"));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(3), countOccurrences(svg, "font-size=\"18.0000\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "dy=\"1.2em\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(1), countOccurrences(svg, "font-size=\"18.0000\" />"));
+}
+
+void RVNGSVGDrawingGeneratorTextTest::testBlankLineWithoutSpanStaysAttributeFree()
+{
+	// Documented limit: when no span style was ever active there is no defensible
+	// font-size basis, so the blank line stays an attribute-free positioned tspan
+	// (empty line and whitespace preserved exactly, no guessed size).
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.insertText("first");
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.insertText("second");
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, ">first</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, ">second</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" />"));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "dy=\"1.2em\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(0), countOccurrences(svg, "font-size="));
+}
+
+void RVNGSVGDrawingGeneratorTextTest::testBlankLineAfterClosedSpanKeepsRunStyle()
+{
+	// Residual D2 boundary (T01-FIX2): the break happens AFTER closeSpan(), so no
+	// span is active when the blank line is finalized. The blank line must still
+	// reuse the previous non-empty run's exact font/size basis instead of
+	// resolving its dy=1.2em against the inherited UA size.
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 18.0));
+		gen.insertText("first");
+		gen.closeSpan();
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.openSpan(style("Lora", 18.0));
+		gen.insertText("second");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	// Exact positioned blank line: the 18pt basis survives the closeSpan().
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"18.0000\" />"));
+	// Three lines, one advance each after the first, and the blank line has a
+	// basis rather than an attribute-free positioned tspan.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(3), countOccurrences(svg, "font-size=\"18.0000\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "dy=\"1.2em\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(1), countOccurrences(svg, "font-size=\"18.0000\" />"));
+	CPPUNIT_ASSERT(!contains(svg, "text-anchor=\"start\" />"));
+}
+
+void RVNGSVGDrawingGeneratorTextTest::testParagraphLeadingBlankKeepsPreviousRunStyle()
+{
+	// Paragraph starts with no active span: its first line is blank and no span
+	// has opened yet. The basis comes from the previous paragraph's last
+	// non-empty run, so the first line still advances against the real size
+	// instead of the inherited UA size (T01-FIX2, paragraph-start boundary).
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 20.0));
+		gen.insertText("p1");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.openParagraph(paragraph("center"));
+		gen.insertLineBreak();
+		gen.openSpan(style("Lora", 20.0));
+		gen.insertText("p2");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"144.0000\" dy=\"1.2em\" text-anchor=\"middle\" font-family=\"Lora\" font-size=\"20.0000\" />"));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(3), countOccurrences(svg, "font-size=\"20.0000\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "dy=\"1.2em\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(1), countOccurrences(svg, "font-size=\"20.0000\" />"));
+	// Per-paragraph anchors are unchanged: p1 start@72, p2 middle@144.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(1), countOccurrences(svg, "tspan x=\"72.0000\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "tspan x=\"144.0000\""));
+}
+
+void RVNGSVGDrawingGeneratorTextTest::testTwoParagraphsAdvanceAndKeepAlignment()
+{
+	// Two paragraphs in one marked text object: the first line of the second
+	// paragraph must advance by the same 1.2em default so it does not overlap the
+	// previous paragraph, while each paragraph keeps its own alignment (D1).
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("p1 line0");
+		gen.insertLineBreak();
+		gen.insertText("p1 line1");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.openParagraph(paragraph("center"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("p2 line0");
+		gen.insertLineBreak();
+		gen.insertText("p2 line1");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+
+	// Exact tspans for all four lines: the second paragraph's first line is
+	// advanced (dy) and anchored at the center, not stacked on p1's baseline.
+	const std::string expectedText =
+	    "<text x=\"72.0000\" y=\"144.0000\" xml:space=\"preserve\">"
+	    "<tspan x=\"72.0000\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" >p1 line0</tspan>"
+	    "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" >p1 line1</tspan>"
+	    "<tspan x=\"144.0000\" dy=\"1.2em\" text-anchor=\"middle\" font-family=\"Lora\" font-size=\"12.0000\" >p2 line0</tspan>"
+	    "<tspan x=\"144.0000\" dy=\"1.2em\" text-anchor=\"middle\" font-family=\"Lora\" font-size=\"12.0000\" >p2 line1</tspan>"
+	    "</text>\n";
+	CPPUNIT_ASSERT(contains(svg, expectedText));
+	// One advance per line after the first line of the object.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(3), countOccurrences(svg, "dy=\"1.2em\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(4), countOccurrences(svg, "text-anchor="));
+	// Paragraph 1 stays left, paragraph 2 stays centered.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "tspan x=\"72.0000\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "tspan x=\"144.0000\""));
+	// The second paragraph's first line is never left un-advanced.
+	CPPUNIT_ASSERT(!contains(svg, "x=\"144.0000\" text-anchor"));
+}
+
+void RVNGSVGDrawingGeneratorTextTest::testMixedInlineSpans()
+{
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("Hello");
+		gen.closeSpan();
+		gen.openSpan(style("DejaVu Sans", 10.0));
+		gen.insertText("World");
+		gen.closeSpan();
+		gen.insertLineBreak();
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("Bye");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	// First line: two spans. Only the first carries the anchor position.
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" >Hello</tspan><tspan font-family=\"DejaVu Sans\" font-size=\"10.0000\" >World</tspan>"));
+	// The second run on a line must not restart the anchor.
+	CPPUNIT_ASSERT(!contains(svg, "x=\"72.0000\" text-anchor=\"start\" font-family=\"DejaVu Sans\""));
+	// Second line reuses the first span style but is positioned by dy.
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"72.0000\" dy=\"1.2em\" text-anchor=\"start\" font-family=\"Lora\" font-size=\"12.0000\" >Bye</tspan>"));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "text-anchor=\"start\""));
+}

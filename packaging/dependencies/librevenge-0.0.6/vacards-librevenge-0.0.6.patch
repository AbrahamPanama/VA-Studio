+void RVNGSVGDrawingGeneratorPrivate::beginMarkedText(double anchorLeft, double anchorCenter, double anchorRight)
+{
+	m_textBuffering = true;
+	m_textSpanOpen = false;
+	m_textRunOpen = false;
+	m_textSpanStyle.clear();
+	m_textLastRunStyle.clear();
+	m_textAnchorLeft = anchorLeft;
+	m_textAnchorCenter = anchorCenter;
+	m_textAnchorRight = anchorRight;
+	m_textParagraphs.clear();
+}
+
+void RVNGSVGDrawingGeneratorPrivate::openTextParagraph(const RVNGPropertyList &propList)
+{
+	TextParagraph paragraph;
+	paragraph.align = getStringValue(propList, "fo:text-align");
+	TextLine firstLine;
+	// The span normally opens after openParagraph, so this is usually empty and
+	// is refreshed by insertTextLineBreak() when the first line stays blank. If
+	// the previous paragraph left a non-empty run style, seed it here so a
+	// paragraph that starts with no active span still has a defensible basis.
+	firstLine.styleBasis = textStyleBasis();
+	paragraph.lines.push_back(firstLine);
+	m_textParagraphs.push_back(paragraph);
+	m_textRunOpen = false;
+}
+
+void RVNGSVGDrawingGeneratorPrivate::openTextSpan(const RVNGPropertyList &style)
+{
+	m_textSpanStyle = style;
+	m_textSpanOpen = true;
+	m_textRunOpen = false;
+}
+
+void RVNGSVGDrawingGeneratorPrivate::closeTextSpan()
+{
+	m_textSpanOpen = false;
+	m_textRunOpen = false;
+	m_textSpanStyle.clear();
+}
+
+RVNGPropertyList RVNGSVGDrawingGeneratorPrivate::textStyleBasis() const
+{
+	// Prefer the span that is active right now; otherwise reuse the exact style
+	// of the most recent non-empty run. There is no fallback beyond that: if no
+	// style was ever buffered for this object the result is empty and the blank
+	// line stays attribute-free rather than guessing (T01-FIX2).
+	if (m_textSpanOpen)
+		return m_textSpanStyle;
+	return m_textLastRunStyle;
+}
+
+void RVNGSVGDrawingGeneratorPrivate::appendText(const std::string &raw)
+{
+	if (!m_textBuffering)
+		return;
+	if (m_textParagraphs.empty())
+		openTextParagraph(RVNGPropertyList());
+	TextParagraph &paragraph = m_textParagraphs.back();
+	if (paragraph.lines.empty())
+		paragraph.lines.push_back(TextLine());
+	TextLine &line = paragraph.lines.back();
+	if (!m_textRunOpen)
+	{
+		TextRun run;
+		if (m_textSpanOpen)
+			run.style = m_textSpanStyle;
+		line.runs.push_back(run);
+		m_textRunOpen = true;
+	}
+	line.runs.back().text += raw;
+	// Remember the exact style of the most recent non-empty run. It survives the
+	// synchronous closeSpan() (contract section 6 deep copy) so a blank line
+	// produced after the span closed still reuses the adjacent run's basis. A
+	// run created without an open span has an empty style, so this records
+	// "no explicit style" rather than a guessed one.
+	if (!raw.empty())
+		m_textLastRunStyle = line.runs.back().style;
+	// Keep the active span style on the line even after the span closes, so a
+	// later blank line still has a defensible font-size basis (D2).
+	line.styleBasis = m_textSpanStyle;
+}
+
+void RVNGSVGDrawingGeneratorPrivate::insertTextLineBreak()
+{
+	if (!m_textBuffering)
+		return;
+	if (m_textParagraphs.empty())
+		openTextParagraph(RVNGPropertyList());
+	TextParagraph &paragraph = m_textParagraphs.back();
+	if (paragraph.lines.empty())
+		paragraph.lines.push_back(TextLine());
+	// The line just ended is blank: freeze the span style basis active at the
+	// break so its dy=1.2em resolves like an adjacent run (D2). When the break
+	// happens after closeSpan() (or at a paragraph start with no open span) the
+	// basis falls back to the most recent non-empty run style; if there is none
+	// it stays empty and the line remains attribute-free (T01-FIX2).
+	if (paragraph.lines.back().runs.empty())
+		paragraph.lines.back().styleBasis = textStyleBasis();
+	TextLine nextLine;
+	nextLine.styleBasis = textStyleBasis();
+	paragraph.lines.push_back(nextLine);
+	m_textRunOpen = false;
+}
+
+void RVNGSVGDrawingGeneratorPrivate::flushMarkedText()
+{
+	// Explicit global line index for the whole object: line 0 sits on the
+	// unchanged 0.0.6 frame baseline and every later line advances by exactly one
+	// kTextLineAdvance ("1.2em", the approved default). The index is incremented
+	// per line, not per paragraph, so the first line of every paragraph after the
+	// first also advances and no paragraph overlaps the previous one (D1).
+	std::size_t lineIndex = 0;
+	for (std::size_t p = 0; p < m_textParagraphs.size(); ++p)
+	{
+		const TextParagraph &paragraph = m_textParagraphs[p];
+		const bool centered = paragraph.align == "center";
+		const bool right = paragraph.align == "end" || paragraph.align == "right";
+		const double anchorX = centered ? m_textAnchorCenter : (right ? m_textAnchorRight : m_textAnchorLeft);
+		const char *anchor = centered ? "middle" : (right ? "end" : "start");
+		for (std::size_t l = 0; l < paragraph.lines.size(); ++l)
+		{
+			const TextLine &line = paragraph.lines[l];
+			const bool advance = (lineIndex > 0);
+			++lineIndex;
+			bool positioned = false;
+			for (std::size_t r = 0; r < line.runs.size(); ++r)
+			{
+				const TextRun &run = line.runs[r];
+				if (run.text.empty())
+					continue;
+				m_outputSink << "<" << getNamespaceAndDelim() << "tspan ";
+				if (!positioned)
+				{
+					m_outputSink << "x=\"" << doubleToString(anchorX) << "\"";
+					if (advance)
+						m_outputSink << " dy=\"" << kTextLineAdvance << "\"";
+					m_outputSink << " text-anchor=\"" << anchor << "\" ";
+					positioned = true;
+				}
+				writeSpanAttributes(run.style);
+				m_outputSink << ">" << RVNGString::escapeXML(RVNGString(run.text.c_str())).cstr()
+				             << "</" << getNamespaceAndDelim() << "tspan>";
+			}
+			if (!positioned)
+			{
+				// A blank hard-break line still needs a positioned tspan so the
+				// break advances the text position instead of being collapsed.
+				// Carry the span style basis captured at the break (D2) so its
+				// dy=1.2em resolves against the same font-size as the adjacent
+				// run; when no span style was ever active the line stays
+				// attribute-free exactly as before.
+				m_outputSink << "<" << getNamespaceAndDelim() << "tspan x=\"" << doubleToString(anchorX) << "\"";
+				if (advance)
+					m_outputSink << " dy=\"" << kTextLineAdvance << "\"";
+				m_outputSink << " text-anchor=\"" << anchor << "\" ";
+				writeSpanAttributes(line.styleBasis);
+				m_outputSink << "/>";
+			}
+		}
+	}
+	// Per-object buffer: released as soon as the object is serialized.
+	m_textBuffering = false;
+	m_textParagraphs.clear();
+}

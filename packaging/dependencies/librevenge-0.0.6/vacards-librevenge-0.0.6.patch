+void RVNGSVGDrawingGeneratorTextTest::testUnicodeAndWhitespace()
+{
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame("text"));
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("Caf\xC3\xA9 \xE2\x82\xAC");
+		gen.insertSpace();
+		gen.insertSpace();
+		gen.insertText("  spaced  ");

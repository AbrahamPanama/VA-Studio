+void RVNGSVGDrawingGeneratorCropTest::testSeparateVisibleFramePreserved()
+{
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList img = makeCropImage();
+		img.insert(kCropPath, rectanglePath());
+		gen.drawGraphicObject(img);
+
+		// An independently visible frame is an ordinary drawPath event and must
+		// survive as a separate visible <path>, not be consumed by the clip.
+		RVNGPropertyList style;
+		style.insert("draw:stroke", "solid");
+		style.insert("svg:stroke-color", "#ff0000");
+		style.insert("draw:fill", "none");
+		gen.setStyle(style);
+		RVNGPropertyListVector d;
+		RVNGPropertyList n;
+		n.insert("librevenge:path-action", "M"); n.insert("svg:x", 0.5); n.insert("svg:y", 0.5); d.append(n);
+		n.clear(); n.insert("librevenge:path-action", "L"); n.insert("svg:x", 1.0); n.insert("svg:y", 0.5); d.append(n);
+		n.clear(); n.insert("librevenge:path-action", "Z"); d.append(n);
+		RVNGPropertyList frame;
+		frame.insert("svg:d", d);
+		gen.drawPath(frame);
+	});
+	CPPUNIT_ASSERT(contains(svg, "<clipPath id=\"cdrclip1\""));
+	CPPUNIT_ASSERT(contains(svg, "</g>\n<path d=\" "));
+	CPPUNIT_ASSERT(contains(svg, "stroke: #ff0000;"));
+}

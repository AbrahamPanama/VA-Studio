+		t.insert(kVersion, 2);
+		t.insert(kContentKind, "text");
+		t.insert(kObjectId, 88);
+		t.insert("librevenge:rotate", 0.0);
+		gen.startTextObject(t);
+		gen.openParagraph(paragraph("center"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("first");
+		gen.insertLineBreak();
+		gen.insertText("second");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, "<!-- librevenge:cdr-text capability=\"unsupported-version\" object-id=\"88\" -->"));
+	CPPUNIT_ASSERT(contains(svg, ">\nfirst\nsecond</tspan>"));
+	CPPUNIT_ASSERT(!contains(svg, "xml:space"));
+	CPPUNIT_ASSERT(!contains(svg, "text-anchor"));
+}

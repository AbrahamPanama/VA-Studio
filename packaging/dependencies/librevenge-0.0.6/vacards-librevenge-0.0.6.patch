+//! Serialize a crop boundary into SVG path data. Returns false if any node is
+//! malformed (unknown action, missing/non-finite coordinates). Deliberately
+//! separate from drawPath so unmarked legacy streams keep their exact bytes.
+static bool serializeCropPath(const RVNGPropertyListVector &path, std::string &out, unsigned long &subpathCount)
+{
+	out.clear();
+	subpathCount = 0;
+	if (path.count() == 0)
+		return false;
+	std::ostringstream sink;
+	for (unsigned long i = 0; i < path.count(); ++i)
+	{
+		const RVNGPropertyList &node = path[i];
+		const RVNGProperty *actionProp = node["librevenge:path-action"];
+		if (!actionProp)
+			return false;
+		const std::string action = actionProp->getStr().cstr();
+		if (action.length() != 1)
+			return false;
+		const char code = action[0];
+		// SVG path data must begin with a moveto; a producer boundary whose
+		// first node is anything else is refused before any clipPath is emitted.
+		if (i == 0 && code != 'M')
+			return false;
+		double x = 0.0, y = 0.0, x1 = 0.0, y1 = 0.0, x2 = 0.0, y2 = 0.0;
+		switch (code)
+		{
+		case 'M':
+			if (!getFiniteNumber(node, "svg:x", x) || !getFiniteNumber(node, "svg:y", y))
+				return false;
+			++subpathCount;
+			sink << "\nM" << doubleToString(72*getInchValue(*node["svg:x"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:y"]));
+			break;
+		case 'L':
+		case 'T':
+			if (!getFiniteNumber(node, "svg:x", x) || !getFiniteNumber(node, "svg:y", y))
+				return false;
+			sink << "\n" << code << doubleToString(72*getInchValue(*node["svg:x"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:y"]));
+			break;
+		case 'H':
+			if (!getFiniteNumber(node, "svg:x", x))
+				return false;
+			sink << "\nH" << doubleToString(72*getInchValue(*node["svg:x"]));
+			break;
+		case 'V':
+			if (!getFiniteNumber(node, "svg:y", y))
+				return false;
+			sink << "\nV" << doubleToString(72*getInchValue(*node["svg:y"]));
+			break;
+		case 'Q':
+		case 'S':
+			if (!getFiniteNumber(node, "svg:x1", x1) || !getFiniteNumber(node, "svg:y1", y1) ||
+			        !getFiniteNumber(node, "svg:x", x) || !getFiniteNumber(node, "svg:y", y))
+				return false;
+			sink << "\n" << code << doubleToString(72*getInchValue(*node["svg:x1"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:y1"])) << " "
+			     << doubleToString(72*getInchValue(*node["svg:x"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:y"]));
+			break;
+		case 'C':
+			if (!getFiniteNumber(node, "svg:x1", x1) || !getFiniteNumber(node, "svg:y1", y1) ||
+			        !getFiniteNumber(node, "svg:x2", x2) || !getFiniteNumber(node, "svg:y2", y2) ||
+			        !getFiniteNumber(node, "svg:x", x) || !getFiniteNumber(node, "svg:y", y))
+				return false;
+			sink << "\nC" << doubleToString(72*getInchValue(*node["svg:x1"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:y1"])) << " "
+			     << doubleToString(72*getInchValue(*node["svg:x2"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:y2"])) << " "
+			     << doubleToString(72*getInchValue(*node["svg:x"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:y"]));
+			break;
+		case 'A':
+		{
+			double arx = 0.0, ary = 0.0;
+			if (!getFiniteNumber(node, "svg:rx", arx) || !getFiniteNumber(node, "svg:ry", ary) ||
+			        !getFiniteNumber(node, "svg:x", x) || !getFiniteNumber(node, "svg:y", y))
+				return false;
+			double rotation = 0.0;
+			if (node["librevenge:rotate"] && !getFiniteNumber(node, "librevenge:rotate", rotation))
+				return false;
+			int largeArc = 1, sweep = 1;
+			if (node["librevenge:large-arc"])
+			{
+				if (node["librevenge:large-arc"]->getUnit() == RVNG_UNIT_ERROR)
+					return false;
+				largeArc = node["librevenge:large-arc"]->getInt();
+			}
+			if (node["librevenge:sweep"])
+			{
+				if (node["librevenge:sweep"]->getUnit() == RVNG_UNIT_ERROR)
+					return false;
+				sweep = node["librevenge:sweep"]->getInt();
+			}
+			sink << "\nA" << doubleToString(72*getInchValue(*node["svg:rx"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:ry"])) << " "
+			     << doubleToString(rotation) << " " << largeArc << "," << sweep << " "
+			     << doubleToString(72*getInchValue(*node["svg:x"]))
+			     << "," << doubleToString(72*getInchValue(*node["svg:y"]));
+			break;
+		}
+		case 'Z':
+			sink << "\nZ";
+			break;
+		default:
+			return false;
+		}
+	}
+	if (subpathCount == 0)
+		return false;
+	out = sink.str();
+	return true;
+}
+
+//! Convert the CDR image->parent affine [a b c d e f] (x'=a x+b y+e,
+//! y'=c x+d y+f; recovered CDRTransforms.cpp) into an SVG matrix. SVG
+//! matrix(A B C D E F) is x'=A x+C y+E, y'=B x+D y+F, so b and c swap.
+static bool getImageTransformMatrix(const RVNGPropertyList &propList, std::string &matrix)
+{
+	const RVNGPropertyListVector *xform = propList.child(cdrImageTransform);
+	if (!xform || xform->count() != 6)
+		return false;
+	double m[6];
+	for (unsigned long i = 0; i < 6; ++i)
+	{
+		if (!getFiniteNumber((*xform)[i], "vacards:cdr-matrix-value", m[i]))
+			return false;
+	}
+	matrix = "matrix(" + doubleToString(m[0]) + ", " + doubleToString(m[2]) + ", " +
+	         doubleToString(m[1]) + ", " + doubleToString(m[3]) + ", " +
+	         doubleToString(m[4]) + ", " + doubleToString(m[5]) + ")";
+	return true;
+}

+void RVNGSVGDrawingGeneratorTextTest::testFTextASnapshotShape()
+{
+	// Shape of the real F-TEXT-A `text88` event stream
+	// (S03/proof/traces/F-TEXT-A-text88.rawtrace.txt): one centered paragraph,
+	// four Lora/14pt spans, 12 insertLineBreak events with runs of consecutive
+	// breaks. line0 "Recuerdo de", line1 " Mi Graduación", line2 " ",
+	// line3 "Escuela Alto Cedro ", seven blank lines, then the date line and a
+	// trailing space line. 13 lines total.
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("center"));
+
+		gen.openSpan(style("Lora", 14.0));
+		gen.insertText("Recuerdo de");
+		gen.insertLineBreak();
+		gen.insertText(" Mi Graduaci\xC3\xB3n");
+		gen.insertLineBreak();
+		gen.closeSpan();
+
+		gen.openSpan(style("Lora", 14.0));
+		gen.insertText(" ");
+		gen.insertLineBreak();
+		gen.insertText("Escuela Alto Cedro ");
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.closeSpan();
+
+		gen.openSpan(style("Lora", 14.0));
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.insertLineBreak();
+		gen.closeSpan();
+
+		gen.openSpan(style("Lora", 14.0));
+		gen.insertText("14 de Diciembre de 2026");
+		gen.insertLineBreak();
+		gen.insertText(" ");
+		gen.closeSpan();
+
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+
+	// 13 lines, 12 breaks, 7 of the lines blank.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(13), countOccurrences(svg, "text-anchor=\"middle\""));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(12), countOccurrences(svg, "dy=\"1.2em\""));
+	// Every blank line carries the active Lora/14pt basis (D2), so none relies
+	// on the inherited UA font-size for its dy.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(7), countOccurrences(svg, "font-size=\"14.0000\" />"));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(0), countOccurrences(svg, "text-anchor=\"middle\" />"));
+	CPPUNIT_ASSERT(contains(svg, "<tspan x=\"144.0000\" dy=\"1.2em\" text-anchor=\"middle\" font-family=\"Lora\" font-size=\"14.0000\" />"));
+	// Every line shares the frame centre, not a per-run anchor.
+	CPPUNIT_ASSERT_EQUAL(std::size_t(13), countOccurrences(svg, "x=\"144.0000\""));
+	// Exact non-blank line strings survive, including the Unicode accent.
+	CPPUNIT_ASSERT(contains(svg, ">Recuerdo de</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, "> Mi Graduaci\xC3\xB3n</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, ">Escuela Alto Cedro </tspan>"));
+	CPPUNIT_ASSERT(contains(svg, ">14 de Diciembre de 2026</tspan>"));
+	// Whitespace-only and blank lines are lines, not collapsed whitespace.
+	CPPUNIT_ASSERT(contains(svg, "> </tspan>"));
+	// No raw break leaks into the editable text content.
+	CPPUNIT_ASSERT(!contains(svg, ">Recuerdo de\n"));
+}

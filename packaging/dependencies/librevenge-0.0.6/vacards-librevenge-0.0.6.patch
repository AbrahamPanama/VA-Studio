+void RVNGSVGDrawingGeneratorTextTest::testUnmarkedTextBytesUnchanged()
+{
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList t = frame();
+		gen.startTextObject(t);
+		gen.openParagraph(RVNGPropertyList());
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("A < B & C");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(std::string(kLegacyTextSvg) == svg);
+	CPPUNIT_ASSERT(!contains(svg, "xml:space"));
+	CPPUNIT_ASSERT(!contains(svg, "text-anchor"));
+	CPPUNIT_ASSERT(!contains(svg, "dy="));
+}
+
+void RVNGSVGDrawingGeneratorTextTest::testUnmarkedLineBreakStaysLiteralNewline()
+{
+	// Absent marker => exact legacy bytes: a break is still a raw newline in a
+	// single tspan, no positioned line is synthesized.
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList t = frame();
+		gen.startTextObject(t);
+		gen.openParagraph(paragraph("center"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("first");
+		gen.insertLineBreak();
+		gen.insertText("second");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, "<text x=\"72.0000\" y=\"144.0000\">\n"));
+	CPPUNIT_ASSERT(contains(svg, ">\nfirst\nsecond</tspan>"));
+	CPPUNIT_ASSERT(!contains(svg, "text-anchor"));
+	CPPUNIT_ASSERT(!contains(svg, "dy="));
+}

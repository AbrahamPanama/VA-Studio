+// Focused synthetic producer/consumer tests for the versioned CDR crop
+// transport serialized by RVNGSVGDrawingGenerator (C02). The producer here is
+// the test itself: it builds the exact property lists the recovered libcdr
+// reader is contracted to emit (S03/CDR_EVENT_CONTRACT.md), and the consumer is
+// the stock generator plus an independent string/SVG oracle.
+
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+
+#include <librevenge/librevenge.h>
+#include <librevenge/RVNGSVGDrawingGenerator.h>
+

+void RVNGSVGDrawingGeneratorCropTest::testImageSpaceTransformOrder()
+{
+	// The image-space boundary must be mapped once by the producer's CDR affine
+	// [a b c d e f]: x'=a x+b y+e, y'=c x+d y+f (CDRTransforms.cpp). C02 carries
+	// that affine as the clipPath transform matrix(a, c, b, d, e, f), which SVG
+	// applies as x'=A x+C y+E, y'=B x+D y+F. This test does not trust the matrix
+	// string: it reads the emitted matrix and boundary back out of the SVG, maps
+	// a landmark with SVG semantics, and compares that with the same landmark
+	// mapped independently by the approved CDR formula. An asymmetric shear makes
+	// a b/c swap observable.
+	const double m[6] = { 1.0, 0.5, -0.5, 1.0, 0.125, -0.25 };
+	const std::string svg = emit([&m](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList img = makeCropImage("image");
+		img.insert(kCropPath, rectanglePath());
+		img.insert(kImageTransform, matrixPath(m));
+		gen.drawGraphicObject(img);
+	});
+	CPPUNIT_ASSERT(contains(svg, "clipPathUnits=\"userSpaceOnUse\" transform="));
+	CPPUNIT_ASSERT(contains(svg, "<g clip-path=\"url(#cdrclip1)\">"));
+	CPPUNIT_ASSERT(contains(svg, kImageElement));
+
+	// Consumer side: read the six emitted SVG matrix entries [A B C D E F].
+	const std::vector<double> svgMatrix = parseNumberList(between(svg, "transform=\"matrix(", ")\""));
+	CPPUNIT_ASSERT(svgMatrix.size() == 6);
+	// Read the emitted first moveto landmark (SVG user units) from path data.
+	const std::vector<double> landmark = parseNumberList(between(between(svg, " d=\"", "\""), "\nM", "\n"));
+	CPPUNIT_ASSERT(landmark.size() == 2);
+
+	// Oracle side: map the source landmark (0.6in, 0.8in -> 43.2pt, 57.6pt)
+	// through the approved CDR formula, using the producer's units.
+	const double srcX = 72.0 * 0.6;
+	const double srcY = 72.0 * 0.8;
+	const double cdrX = m[0] * srcX + m[1] * srcY + m[4];
+	const double cdrY = m[2] * srcX + m[3] * srcY + m[5];
+
+	// Consumer maps the emitted landmark with SVG matrix order.
+	const double mappedX = svgMatrix[0] * landmark[0] + svgMatrix[2] * landmark[1] + svgMatrix[4];
+	const double mappedY = svgMatrix[1] * landmark[0] + svgMatrix[3] * landmark[1] + svgMatrix[5];
+	CPPUNIT_ASSERT_DOUBLES_EQUAL(cdrX, mappedX, 1e-4);
+	CPPUNIT_ASSERT_DOUBLES_EQUAL(cdrY, mappedY, 1e-4);
+	// this shear must actually move the landmark (guards a no-op mapping)
+	CPPUNIT_ASSERT(std::fabs(mappedX - srcX) > 1.0 || std::fabs(mappedY - srcY) > 1.0);
+}

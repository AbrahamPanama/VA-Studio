+void RVNGSVGDrawingGeneratorCropTest::testShearNotDoubleApplied()
+{
+	// The image carries an asymmetric affine (rotation); the parent-space
+	// boundary must stay exactly where the producer put it.
+	const std::string plain = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		RVNGPropertyList img = makeCropImage();

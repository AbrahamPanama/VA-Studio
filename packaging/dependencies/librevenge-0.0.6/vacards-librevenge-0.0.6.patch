+//! XML-escape a value that is written into an attribute (quotes included).
+//! Text nodes already go through RVNGString::escapeXML; this closes the
+//! attribute-side gap found by S03 (raw font-family values).
+static std::string escapeXmlAttribute(const RVNGString &value)
+{
+	return RVNGString::escapeXML(value).cstr();
+}
+
+//! Read a finite numeric property. A string/binary property reports
+//! RVNG_UNIT_ERROR, which is treated as malformed rather than silently zero.
+static bool getFiniteNumber(const RVNGPropertyList &propList, const char *name, double &value)
+{
+	const RVNGProperty *prop = propList[name];
+	if (!prop || prop->getUnit() == RVNG_UNIT_ERROR)
+		return false;
+	value = prop->getDouble();
+	return std::isfinite(value);
+}

+void RVNGSVGDrawingGeneratorTextTest::testBufferReleasedPerObject()
+{
+	// Two marked objects in one page: the second must not replay the first.
+	const std::string svg = emit([](RVNGSVGDrawingGenerator &gen)
+	{
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("left"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("one");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+
+		gen.startTextObject(markedFrame());
+		gen.openParagraph(paragraph("center"));
+		gen.openSpan(style("Lora", 12.0));
+		gen.insertText("two");
+		gen.closeSpan();
+		gen.closeParagraph();
+		gen.endTextObject();
+	});
+	CPPUNIT_ASSERT(contains(svg, ">one</tspan>"));
+	CPPUNIT_ASSERT(contains(svg, ">two</tspan>"));
+	// one anchored line per object, not a growing buffer
+	CPPUNIT_ASSERT_EQUAL(std::size_t(2), countOccurrences(svg, "text-anchor="));
+	CPPUNIT_ASSERT_EQUAL(std::size_t(0), countOccurrences(svg, "dy=\"1.2em\""));
+}

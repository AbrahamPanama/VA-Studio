+// Focused synthetic producer/consumer tests for explicit text lines and
+// paragraph alignment serialized by RVNGSVGDrawingGenerator (T01).
+//
+// The producer is the test itself: it builds the exact property/event stream
+// that the recovered libcdr reader is contracted to emit
+// (S03/CDR_EVENT_CONTRACT.md section 3.2). The consumer is the stock generator
+// plus an independent string oracle. Values are asserted exactly (line strings,
+// line count, anchor attribute and anchor position), not merely by presence.
+//
+// The only spacing value used for a hard break is the documented, standards
+// based CSS `line-height: normal` default expressed as SVG `dy="1.2em"`. The
+// CDR transport carries no line/baseline metric (contract section 8), so no
+// Corel line-height, per-line metric or custom line breaker is invented here.
+
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+
+#include <librevenge/librevenge.h>
+#include <librevenge/RVNGSVGDrawingGenerator.h>
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace test
+{
+
+using namespace librevenge;
+
+namespace
+{
+
+const char *const kVersion = "vacards:cdr-fidelity-version";
+const char *const kContentKind = "vacards:cdr-content-kind";
+const char *const kTextKind = "vacards:cdr-text-kind";
+const char *const kObjectId = "vacards:cdr-object-id";
+
+//! Exact pre-patch (0.0.6, C02 only) bytes for one unmarked text object with a
+//! single Lora/12pt span, captured from the tree before the T01 change. This is
+//! the strongest available byte-compatibility oracle for an unmarked stream.
+const char *const kLegacyTextSvg =
+    "<svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"4.0000in\" height=\"4.0000in\" viewBox=\"0 0 288.0000 288.0000\" >\n"
+    "<text x=\"72.0000\" y=\"144.0000\">\n"
+    "<tspan font-family=\"Lora\" font-size=\"12.0000\" >\n"
+    "A &lt; B &amp; C</tspan>\n"
+    "</text>\n"
+    "</svg>\n\n";
+
+bool contains(const std::string &haystack, const std::string &needle)
+{
+	return haystack.find(needle) != std::string::npos;
+}
+
+std::size_t countOccurrences(const std::string &haystack, const std::string &needle)
+{
+	std::size_t count = 0, pos = 0;
+	while ((pos = haystack.find(needle, pos)) != std::string::npos)
+	{
+		++count;
+		pos += needle.size();
+	}
+	return count;
+}
+
+template <class F>
+std::string emit(F fill)
+{
+	RVNGStringVector out;
+	RVNGSVGDrawingGenerator gen(out, "");
+	RVNGPropertyList doc;
+	gen.startDocument(doc);
+	RVNGPropertyList page;
+	page.insert("svg:width", 4.0);
+	page.insert("svg:height", 4.0);
+	gen.startPage(page);
+	fill(gen);
+	gen.endPage();
+	gen.endDocument();
+	std::string all;
+	for (unsigned i = 0; i < out.size(); ++i)
+	{
+		all += out[i].cstr();
+		all += "\n";
+	}
+	return all;
+}
+
+//! Frame used by every marked case: x=1in y=1in w=2in h=1in -> anchors at
+//! 72pt (left), 144pt (center) and 216pt (right); baseline at 144pt.
+RVNGPropertyList frame()
+{
+	RVNGPropertyList t;
+	t.insert("svg:x", 1.0);
+	t.insert("svg:y", 1.0);
+	t.insert("svg:width", 2.0);
+	t.insert("svg:height", 1.0);
+	return t;
+}
+
+RVNGPropertyList markedFrame(const char *kind = "text")
+{
+	RVNGPropertyList t = frame();
+	t.insert(kVersion, 1);
+	t.insert(kContentKind, kind);
+	t.insert(kTextKind, "artistic");
+	t.insert(kObjectId, 88);
+	return t;
+}
+
+RVNGPropertyList style(const char *font, double sizePt)
+{
+	RVNGPropertyList s;
+	s.insert("fo:font-size", sizePt, RVNG_POINT);
+	if (font)
+		s.insert("style:font-name", font);
+	return s;
+}
+
+RVNGPropertyList paragraph(const char *align)
+{
+	RVNGPropertyList p;
+	if (align)
+		p.insert("fo:text-align", align);
+	return p;
+}
+

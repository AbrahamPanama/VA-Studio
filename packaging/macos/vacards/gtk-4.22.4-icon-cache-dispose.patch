+static void
+gtk_icon_paintable_dispose (GObject *object)
+{
+  /* Remove the raw cache entry before GObject marks this icon finalized.
+   * A concurrent lookup may still acquire a reference during dispose, but
+   * must never find an object whose finalizer is waiting for the cache lock.
+   */
+  icon_cache_remove ((GtkIconPaintable *) object);
+
+  G_OBJECT_CLASS (gtk_icon_paintable_parent_class)->dispose (object);
 }
 

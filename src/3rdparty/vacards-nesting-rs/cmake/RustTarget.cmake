# Keep the policy independent of compiler discovery so it can be tested without
# pretending a native build proves that a different platform links correctly.
function(vacards_nesting_rust_target host system processor pointer_size compiler architectures requested output)
    if(NOT requested STREQUAL "" AND NOT requested MATCHES "^[A-Za-z0-9_]+(-[A-Za-z0-9_]+)+$")
        message(FATAL_ERROR "Invalid VACards nesting Rust target: '${requested}'")
    endif()
    set(expected "${host}")
    if(system STREQUAL "Windows")
        if(NOT pointer_size STREQUAL "8" OR NOT processor MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
            message(FATAL_ERROR "VACards nesting Windows builds currently require x86-64")
        endif()
        if(compiler STREQUAL "MSVC")
            set(expected "x86_64-pc-windows-msvc")
        elseif(compiler MATCHES "^(GNU|Clang)$")
            set(expected "x86_64-pc-windows-gnu")
        else()
            message(FATAL_ERROR "Unsupported VACards nesting Windows compiler: ${compiler}")
        endif()
    elseif(system STREQUAL "Darwin")
        set(arch "${processor}")
        if(NOT architectures STREQUAL "")
            list(LENGTH architectures architecture_count)
            if(NOT architecture_count EQUAL 1)
                message(FATAL_ERROR "VACards nesting requires a single macOS architecture per build")
            endif()
            set(arch "${architectures}")
        endif()
        if(arch MATCHES "^(arm64|aarch64)$")
            set(expected "aarch64-apple-darwin")
        elseif(arch STREQUAL "x86_64")
            set(expected "x86_64-apple-darwin")
        else()
            message(FATAL_ERROR "Unsupported VACards nesting macOS architecture: ${arch}")
        endif()
    elseif(system STREQUAL "Linux")
        set(arch "${processor}")
        if(arch MATCHES "^(AMD64|amd64|X86_64)$")
            set(arch "x86_64")
        elseif(arch STREQUAL "arm64")
            set(arch "aarch64")
        elseif(arch MATCHES "^i[3-6]86$")
            set(arch "i686")
        elseif(arch MATCHES "^armv7")
            set(arch "armv7")
        endif()
        if(NOT requested STREQUAL "")
            set(expected "${requested}")
        endif()
        string(REGEX MATCH "^[^-]+" rust_arch "${expected}")
        if(NOT rust_arch STREQUAL arch OR NOT expected MATCHES "-linux-")
            message(FATAL_ERROR "VACards nesting Rust target '${expected}' does not match Linux/${processor}")
        endif()
    endif()
    if(NOT requested STREQUAL "" AND NOT requested STREQUAL expected)
        message(FATAL_ERROR
            "VACards nesting Rust target '${requested}' does not match '${expected}' for this C/C++ toolchain")
    endif()
    if(NOT expected MATCHES "^[A-Za-z0-9_]+(-[A-Za-z0-9_]+)+$")
        message(FATAL_ERROR "Invalid VACards nesting Rust target: '${expected}'")
    endif()
    set(${output} "${expected}" PARENT_SCOPE)
endfunction()

function(vacards_nesting_require_stdlib status directory target)
    file(GLOB target_std "${directory}/libstd-*.rlib")
    if(NOT status STREQUAL "0" OR NOT target_std)
        message(FATAL_ERROR "Rust standard library for ${target} is unavailable; install the pinned target before configuring")
    endif()
endfunction()

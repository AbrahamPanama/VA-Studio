<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="bitmap-eraser-size-adjustment">
    <property name="lower">1</property>
    <property name="upper">2000</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
    <property name="value">40</property>
  </object>
  <object class="GtkAdjustment" id="bitmap-eraser-hardness-adjustment">
    <property name="lower">0</property>
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
    <property name="value">100</property>
  </object>
  <object class="GtkBox" id="bitmap-eraser-toolbar">
    <property name="halign">start</property>
    <property name="valign">center</property>
    <property name="hexpand">True</property>
    <child>
      <object class="GtkLabel">
        <property name="label" translatable="yes">Tip:</property>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">3</property>
        <child>
          <object class="GtkToggleButton" id="round-tip">
            <property name="focusable">True</property>
            <property name="focus-on-click">False</property>
            <property name="has-frame">False</property>
            <property name="tooltip-text" translatable="yes">Round bitmap eraser tip</property>
            <property name="icon-name">shape-circle</property>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="square-tip">
            <property name="group">round-tip</property>
            <property name="focusable">True</property>
            <property name="focus-on-click">False</property>
            <property name="has-frame">False</property>
            <property name="tooltip-text" translatable="yes">Square bitmap eraser tip</property>
            <property name="icon-name">draw-rectangle</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator"/>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">4</property>
        <property name="tooltip-text" translatable="yes">Bitmap eraser diameter in document pixels</property>
        <style>
          <class name="priority1"/>
          <class name="groupsize2"/>
        </style>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Size</property>
          </object>
        </child>
        <child>
          <object class="gtkmm__CustomObject_InkSpinButton" id="bitmap-eraser-size">
            <property name="name">bitmap-eraser-size</property>
            <property name="focusable">True</property>
            <property name="adjustment">bitmap-eraser-size-adjustment</property>
            <property name="climb-rate">1</property>
            <property name="digits">0</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">px</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">4</property>
        <property name="tooltip-text" translatable="yes">Hardness of the bitmap eraser edge</property>
        <style>
          <class name="priority1"/>
          <class name="groupsize2"/>
        </style>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Hardness</property>
          </object>
        </child>
        <child>
          <object class="gtkmm__CustomObject_InkSpinButton" id="bitmap-eraser-hardness">
            <property name="focusable">True</property>
            <property name="adjustment">bitmap-eraser-hardness-adjustment</property>
            <property name="climb-rate">1</property>
            <property name="digits">0</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">%</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator">
        <style><class name="priority1"/></style>
      </object>
    </child>
    <child>
      <object class="GtkToggleButton" id="bitmap-eraser-pressure">
        <property name="focusable">True</property>
        <property name="focus-on-click">False</property>
        <property name="has-frame">False</property>
        <property name="tooltip-text" translatable="yes">Use tablet pressure to change the eraser size</property>
        <property name="icon-name">draw-use-pressure</property>
        <style><class name="priority1"/></style>
      </object>
    </child>
    <style>
      <class name="inkscape-toolbar"/>
    </style>
  </object>
</interface>

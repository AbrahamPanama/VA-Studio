{
  "description": "One vacards-undo restores the bitmap: the clip is exactly one Undo step. The cutter is never removed (CLIP-1).",
  "input": "{FIXTURES}/clip.svg",
  "actions": "vacards-result-file:{RESULT};export-filename:{WORK}/before.svg;export-do;select-by-id:img1,cut1;vacards-destructive-clip;vacards-undo;export-filename:{WORK}/after.svg;export-do",
  "expect_exit": 0,
  "expect_records": [
    {
      "action": "vacards-result-file",
      "status": "ok"
    },
    {
      "action": "vacards-destructive-clip",
      "status": "changed",
      "undo": "one-step"
    },
    {
      "action": "vacards-undo",
      "status": "changed"
    }
  ],
  "expect_same_files": [
    [
      "before.svg",
      "after.svg"
    ]
  ]
}

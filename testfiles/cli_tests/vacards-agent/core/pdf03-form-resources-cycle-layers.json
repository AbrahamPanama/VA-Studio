{
  "description": "PDF3: a form whose resources reference itself must not recurse forever in loadOptionalContentLayers (group by layer).",
  "input": "{FIXTURES}/pdf3-form-cycle.pdf",
  "args": [
    "--export-type=svg",
    "--export-filename={WORK}/out.svg",
    "--pdf-group-by=layer"
  ],
  "timeout": 90,

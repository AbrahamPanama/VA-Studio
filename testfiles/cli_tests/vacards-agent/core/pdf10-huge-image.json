{
  "description": "PDF10: an image claiming 400 megapixels is skipped with a warning instead of hanging or exhausting memory.",
  "input": "{FIXTURES}/pdf10-huge-image.pdf",
  "args": [
    "--export-type=svg",
    "--export-filename={WORK}/out.svg"
  ],
  "timeout": 90,
  "expect_exit": 0,
  "expect_files": {
    "out.svg": {
      "exists": true,
      "contains": [
        "<svg"
      ]
    }
  },
  "expect_stderr_contains": [
    "megapixel limit"
  ]
}

{
  "description": "PDF12: a form that draws itself twice must not run ~2^20 times.",
  "input": "{FIXTURES}/pdf12-form-twice.pdf",
  "args": [
    "--export-type=svg",
    "--export-filename={WORK}/out.svg"
  ],
  "timeout": 90,
  "expect_exit": 0,
  "expect_files": {
    "out.svg": {
      "exists": true,
      "contains": [
        "<svg"
      ]
    }
  }
}

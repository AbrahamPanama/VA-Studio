{
  "description": "One vacards-undo reverts setting a nesting contour (grouping and markers) completely.",
  "input": "{FIXTURES}/contour.svg",
  "actions": "vacards-result-file:{RESULT};export-filename:{WORK}/before.svg;export-do;select-by-id:art,cut;selection-set-nesting-contour;vacards-undo;export-filename:{WORK}/after.svg;export-do",
  "expect_exit": 0,
  "expect_records": [
    {"action": "vacards-result-file", "status": "ok"},
    {"action": "selection-set-nesting-contour", "status": "changed", "undo": "one-step"},
    {"action": "vacards-undo", "status": "changed"}
  ],
  "expect_same_files": [["before.svg", "after.svg"]]
}

{
  "description": "A shape type whose outline is empty is excluded with reason empty-geometry, distinct from the not-a-shape reason for an unsupported type; nothing changes.",
  "input": "{FIXTURES}/geometry.svg",
  "actions": "vacards-result-file:{RESULT};vacards-options:halt-on-error=false;select-by-id:a,empty;vacards-boolean:op=union;export-filename:{WORK}/out.svg;export-do",
  "expect_exit": 3,
  "expect_records": [
    {"action": "vacards-result-file", "status": "ok"},
    {"action": "vacards-options", "status": "ok"},
    {
      "action": "vacards-boolean",
      "status": "rejected",
      "mode": "collective-geometry",
      "reason": "incompatible-operands",
      "targets": {"selected": 2, "excluded": [{"id": "empty", "reason": "empty-geometry"}]},
      "undo": "none"
    }
  ],
  "expect_files": {
    "out.svg": {
      "exists": true,
      "contains": ["id=\"a\"", "id=\"empty\""]
    }
  }
}

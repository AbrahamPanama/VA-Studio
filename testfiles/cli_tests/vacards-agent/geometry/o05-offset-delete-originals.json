{
  "description": "delete-originals removes the produced source and reports its id; the export no longer contains the rectangle.",
  "input": "{FIXTURES}/offset.svg",
  "actions": "vacards-result-file:{RESULT};select-by-id:sq;vacards-offset:distance=2,delete-originals;export-filename:{WORK}/out.svg;export-do",
  "expect_exit": 0,
  "expect_records": [
    {"action": "vacards-result-file", "status": "ok"},
    {
      "action": "vacards-offset",
      "status": "changed",
      "mode": "per-selected-root",
      "reason": "success",
      "targets": {"selected": 1, "eligible": 1},
      "created": ["path1"],
      "deleted": ["sq"],
      "selection_after": ["path1"],
      "undo": "one-step",
      "metrics": {"skipped": 0, "open_subpaths_skipped": 0, "results": 1}
    }
  ],
  "expect_files": {
    "out.svg": {
      "exists": true,
      "contains": ["id=\"path1\""],
      "not_contains": ["id=\"sq\""]
    }
  }
}

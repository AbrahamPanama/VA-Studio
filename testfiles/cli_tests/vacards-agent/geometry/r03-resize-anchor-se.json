{
  "description": "Resizing to width=40 with the se anchor keeps the bottom-right corner fixed at (20,20).",
  "input": "{FIXTURES}/geometry.svg",
  "actions": "vacards-result-file:{RESULT};select-by-id:a;vacards-transform-resize:width=40,anchor=se;export-filename:{WORK}/out.svg;export-do",
  "expect_exit": 0,
  "expect_records": [
    {"action": "vacards-result-file", "status": "ok"},
    {
      "action": "vacards-transform-resize",
      "status": "changed",
      "reason": "success",
      "metrics": {"old_width": 20.0, "old_height": 20.0, "new_width": 40.0, "new_height": 20.0}
    }
  ],
  "expect_files": {
    "out.svg": {"exists": true, "contains": ["x=\"-20\"", "width=\"40\""]}
  }
}

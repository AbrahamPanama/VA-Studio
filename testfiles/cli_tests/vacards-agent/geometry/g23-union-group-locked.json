{
  "description": "A selected group with a locked member is refused as unavailable; the offending descendant is reported and nothing changes.",
  "input": "{FIXTURES}/groups-boolean.svg",
  "actions": "vacards-result-file:{RESULT};vacards-options:halt-on-error=false;select-by-id:r1,glock;vacards-boolean:op=union;export-filename:{WORK}/out.svg;export-do",
  "expect_exit": 3,
  "expect_records": [
    {"action": "vacards-result-file", "status": "ok"},
    {"action": "vacards-options", "status": "ok"},
    {
      "action": "vacards-boolean",
      "status": "rejected",
      "mode": "collective-geometry",
      "reason": "incompatible-operands",
      "targets": {"selected": 2, "excluded": [{"id": "glocka", "reason": "unavailable"}]},
      "undo": "none"
    }
  ],
  "expect_files": {
    "out.svg": {"exists": true, "contains": ["id=\"r1\"", "id=\"glock\"", "id=\"glocka\""]}
  }
}

{
  "description": "A tiny simplify-tolerance (the parameter minimum) is clamped to 0.001 px, so the offset returns promptly instead of exploding livarot's pre-sampling; the circle outline is still produced in one Undo step.",
  "input": "{FIXTURES}/offset.svg",
  "actions": "vacards-result-file:{RESULT};select-by-id:ci;vacards-offset:distance=2,simplify=true,simplify-tolerance=0.000001",
  "timeout": 60,
  "expect_exit": 0,
  "expect_records": [
    {"action": "vacards-result-file", "status": "ok"},
    {
      "action": "vacards-offset",
      "status": "changed",
      "mode": "per-selected-root",
      "reason": "success",
      "targets": {"selected": 1, "eligible": 1},
      "undo": "one-step",
      "metrics": {"skipped": 0, "results": 1}
    }
  ]
}

{
  "description": "One vacards-undo removes the offset completely: the exports before and after are byte-identical, so the offset is exactly one Undo step.",
  "input": "{FIXTURES}/offset.svg",
  "actions": "vacards-result-file:{RESULT};export-filename:{WORK}/before.svg;export-do;select-by-id:sq;vacards-offset:distance=2;vacards-undo;export-filename:{WORK}/after.svg;export-do",
  "expect_exit": 0,
  "expect_records": [
    {"action": "vacards-result-file", "status": "ok"},
    {
      "action": "vacards-offset",
      "status": "changed",
      "mode": "per-selected-root",
      "reason": "success",
      "created": ["path1"],
      "undo": "one-step"
    },
    {"action": "vacards-undo", "status": "changed"}
  ],
  "expect_same_files": [["before.svg", "after.svg"]]
}

        },
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "subject",
            "command": "bitmap.tone-query",
            "params": {
              "ids": [
                "image1"
              ],
              "mode": "compatible-members"
            },
            "document": {
              "$ref": "open.document_id"

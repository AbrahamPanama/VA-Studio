{
  "description": "duplicate-id",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "same",
        "command": "session.status",
        "params": {}
      },
      "command": "session.status",
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        }
      },
      "cells": [
        "success"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "same",
        "command": "session.status",
        "params": {}
      },
      "command": "session.status",
      "expect": {
        "status": "rejected",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        }
      },
      "expect_error": "duplicate-request-id",
      "expect_accepted": false,
      "cells": [
        "refusal"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "after",
        "command": "session.status",
        "params": {}
      },
      "command": "session.status",
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        }
      },
      "cells": [
        "success"
      ]
    }
  ],
  "expect_exit": 0,
  "expect_stderr_not_contains": [
    "VASTUDIO-RESULT ",
    "Gtk-WARNING"
  ]
}

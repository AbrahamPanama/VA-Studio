{
  "schema": "p9-m3-cases/1",
  "cases": [
    {
      "id": "clip.set:success",
      "command": "clip.set",
      "cell": "success",
      "description": "Independent P9 clip.set:success",
      "startup_args": [
        "--grant-read",
        "{FIXTURES}/m3"
      ],
      "timeout": 30,
      "requests": [
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "open",
            "command": "file.open",
            "if_revision": 0,
            "params": {
              "path": "{FIXTURES}/m3/clip.svg",
              "format": "svg",
              "resource-policy": "embed",
              "font-policy": "reject",
              "discard": false
            }
          },
          "expect": {
            "status": "changed"
          }
        },
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "before",
            "command": "session.status",
            "params": {}
          },
          "expect": {
            "status": "ok"
          }
        },
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "subject",
            "command": "clip.set",
            "params": {
              "target-id": "shape1",
              "cutter-id": "cutter1",
              "keep-cutter": true
            },
            "document": {
              "$ref": "open.document_id"
            },
            "if_revision": {
              "$ref": "before.revision_after"
            }
          },
          "m3": true,
          "expect": {
            "status": "changed",
            "data": {
              "variant": "success",
              "relations": [
                {
                  "target-id": "shape1",
                  "cutter-id": "cutter1",
                  "target-retained": true,
                  "cutter-retained": true
                }
              ]
            }
          },
          "expect_absent": [
            "error"
          ]
        }
      ],
      "expect_exit": 0
    },

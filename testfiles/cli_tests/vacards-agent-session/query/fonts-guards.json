{
  "description": "Wrong document incarnation and future native revision refuse without affecting the next read.",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r1",
        "command": "query.fonts",
        "params": {},
        "document": "other-document"
      },
      "command": "query.fonts",
      "expect": {
        "status": "rejected",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": []
      },
      "cells": [
        "refusal"
      ],
      "expect_error": "stale-document",
      "expect_accepted": true
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r2",
        "command": "query.fonts",
        "params": {},
        "if_revision": 1
      },
      "command": "query.fonts",
      "expect": {
        "status": "rejected",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": []
      },
      "cells": [
        "refusal"
      ],
      "expect_error": "stale-revision",
      "expect_accepted": true
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r3",
        "command": "query.fonts",
        "params": {},
        "document": "d1",
        "if_revision": 0
      },
      "command": "query.fonts",
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": [],
        "data": {
          "items": [
            {
              "family": "VA_CLI_MissingFont_9f5e",
              "style": "italic",
              "weight": "700",
              "stretch": "normal",
              "object_id": "text",
              "available": false,
              "missing": true
            }
          ],
          "total": 1,
          "limit": 100,
          "next_cursor": null,
          "document_id": "d1",
          "revision": 0
        }
      },
      "cells": [
        "success"
      ],
      "expect_exact": {
        "dry_run": false,
        "created": [],
        "modified": [],
        "deleted": [],
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": []
      },
      "expect_nonempty": [
        "document_id"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "close",
        "command": "session.close",
        "params": {}
      },
      "command": "session.close",
      "expect": {
        "status": "ok",
        "data": {
          "closed": true,
          "persisted": false
        },
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        }
      }
    }
  ],
  "expect_exit": 0,
  "expect_stderr_not_contains": [
    "VASTUDIO-RESULT ",
    "Gtk-WARNING"
  ],
  "startup_args": [
    "--inspect-file",
    "{FIXTURES}/../../vacards-agent-session/query/fixtures/inspection.svg",
    "--grant-read",
    "{FIXTURES}/../../vacards-agent-session/query/fixtures"
  ],
  "expect_hello": {
    "document": {
      "id": "d1",
      "revision": 0,
      "dirty": false,
      "read_only": true
    }
  },
  "expect_hello_nonempty": [
    "document.inspection.source_sha256"
  ]
}

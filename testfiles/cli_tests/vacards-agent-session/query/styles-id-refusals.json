{
  "description": "Unknown/duplicate IDs and malformed ID arrays refuse; IDs never silently choose an implicit first object.",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r1",
        "command": "query.styles",
        "params": {
          "ids": [
            "does-not-exist"
          ]
        }
      },
      "command": "query.styles",
      "expect": {
        "status": "rejected",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": []
      },
      "cells": [
        "refusal"
      ],
      "expect_error": "unknown-id",
      "expect_accepted": true
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r2",
        "command": "query.styles",
        "params": {
          "ids": [
            "rect",
            "rect"
          ]
        }
      },
      "command": "query.styles",
      "expect": {
        "status": "rejected",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": []
      },
      "cells": [
        "invalid",
        "refusal"
      ],
      "expect_error": "duplicate-id",
      "expect_accepted": true
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",

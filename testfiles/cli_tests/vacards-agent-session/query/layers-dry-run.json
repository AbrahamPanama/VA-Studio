{
  "description": "Read-only envelope dry_run returns the same independently calculated query, then ordinary read verifies preservation.",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r1",
        "command": "query.layers",
        "params": {},
        "dry_run": true
      },
      "command": "query.layers",
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": [],
        "data": {
          "items": [
            {
              "id": "sheet",
              "label": "Sheet",
              "parent_id": null,
              "depth": 0,
              "visible": true,
              "locked": false
            },
            {
              "id": "childLayer",
              "label": "Child",
              "parent_id": "sheet",
              "depth": 1,
              "visible": true,
              "locked": false
            },
            {
              "id": "hiddenLayer",
              "label": "Hidden",
              "parent_id": null,
              "depth": 0,
              "visible": false,
              "locked": false
            },
            {
              "id": "lockedLayer",
              "label": "Locked",
              "parent_id": null,
              "depth": 0,
              "visible": true,
              "locked": true
            }
          ],
          "total": 4,
          "limit": 100,
          "next_cursor": null,
          "document_id": "d1",
          "revision": 0
        }
      },
      "cells": [
        "dry-run",
        "success"
      ],
      "expect_exact": {
        "dry_run": true,
        "created": [],
        "modified": [],
        "deleted": [],
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": []
      },
      "expect_nonempty": [
        "document_id"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r2",
        "command": "query.layers",
        "params": {}
      },
      "command": "query.layers",
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": [],
        "data": {
          "items": [
            {
              "id": "sheet",
              "label": "Sheet",
              "parent_id": null,
              "depth": 0,
              "visible": true,
              "locked": false
            },
            {
              "id": "childLayer",
              "label": "Child",

{
  "description": "Group opacity .75 is compositing; child computed opacity is independently 1.",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r1",
        "command": "query.styles",
        "params": {
          "ids": [
            "nested",
            "rect"
          ],
          "properties": [
            "fill",
            "stroke-width",
            "opacity"
          ]
        }
      },
      "command": "query.styles",
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": [],
        "data": {
          "items": [
            {
              "id": "nested",
              "properties": {
                "fill": "#123456",
                "stroke-width": {
                  "px": 4,
                  "preferred": {
                    "value": 1.0583333333333333,
                    "unit": "mm"
                  }
                },
                "opacity": 0.75
              }
            },
            {
              "id": "rect",
              "properties": {
                "fill": "#123456",
                "stroke-width": {
                  "px": 4,
                  "preferred": {
                    "value": 1.0583333333333333,
                    "unit": "mm"
                  }
                },
                "opacity": 1
              }
            }
          ],
          "total": 2,
          "limit": 100,
          "next_cursor": null,
          "document_id": "d1",
          "revision": 0
        }
      },
      "cells": [
        "group",
        "success"
      ],
      "expect_exact": {
        "dry_run": false,
        "created": [],
        "modified": [],
        "deleted": [],
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": []
      },
      "expect_nonempty": [
        "document_id"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "close",
        "command": "session.close",
        "params": {}
      },
      "command": "session.close",
      "expect": {
        "status": "ok",
        "data": {
          "closed": true,
          "persisted": false
        },
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        }
      }
    }
  ],
  "expect_exit": 0,
  "expect_stderr_not_contains": [
    "VASTUDIO-RESULT ",
    "Gtk-WARNING"
  ],
  "startup_args": [
    "--inspect-file",
    "{FIXTURES}/../../vacards-agent-session/query/fixtures/inspection.svg",
    "--grant-read",
    "{FIXTURES}/../../vacards-agent-session/query/fixtures"
  ],
  "expect_hello": {
    "document": {
      "id": "d1",
      "revision": 0,
      "dirty": false,
      "read_only": true
    }
  },
  "expect_hello_nonempty": [
    "document.inspection.source_sha256"
  ]
}

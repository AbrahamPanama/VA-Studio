{
  "description": "Both explicitly requested text objects are reported; a group is excluded without losing compatible text rows.",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "r1",
        "command": "query.fonts",
        "params": {
          "ids": [
            "cards",
            "headline",
            "footer"
          ]
        }
      },
      "command": "query.fonts",
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        },
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": [],
        "data": {
          "items": [
            {
              "family": "sans-serif",
              "style": "normal",
              "weight": "400",
              "stretch": "normal",
              "object_id": "headline",
              "available": true,
              "missing": false
            },
            {
              "family": "VA_CLI_MissingFont_9f5e",
              "style": "normal",
              "weight": "400",
              "stretch": "normal",
              "object_id": "footer",
              "available": false,
              "missing": true
            }
          ],
          "total": 2,
          "limit": 100,
          "next_cursor": null,
          "document_id": "d1",
          "revision": 0
        }
      },
      "cells": [
        "group",
        "success"
      ],
      "expect_exact": {
        "dry_run": false,
        "created": [],
        "modified": [],
        "deleted": [],
        "revision_before": 0,
        "revision_after": 0,
        "selection_after": []
      },
      "expect_nonempty": [
        "document_id"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "close",
        "command": "session.close",
        "params": {}
      },
      "command": "session.close",
      "expect": {
        "status": "ok",
        "data": {
          "closed": true,
          "persisted": false
        },
        "undo_effect": "none",
        "created": [],
        "modified": [],
        "deleted": [],
        "publication": {
          "persisted": false
        }
      }
    }
  ],
  "expect_exit": 0,
  "expect_stderr_not_contains": [
    "VASTUDIO-RESULT ",
    "Gtk-WARNING"
  ],
  "startup_args": [
    "--inspect-file",
    "{FIXTURES}/../../vacards-agent-session/query/fixtures/print-sheet.svg",
    "--grant-read",
    "{FIXTURES}/../../vacards-agent-session/query/fixtures"
  ],
  "expect_hello": {
    "document": {
      "id": "d1",
      "revision": 0,
      "dirty": false,
      "read_only": true
    }
  },
  "expect_hello_nonempty": [
    "document.inspection.source_sha256"
  ]
}

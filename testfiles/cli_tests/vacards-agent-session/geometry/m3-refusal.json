      "id": "geometry.move:refusal",
      "command": "geometry.move",
      "cell": "refusal",
      "description": "Independent P9 geometry.move:refusal",
      "startup_args": [
        "--grant-read",
        "{FIXTURES}/m3"
      ],
      "timeout": 30,
      "requests": [
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "open",
            "command": "file.open",
            "if_revision": 0,
            "params": {
              "path": "{FIXTURES}/m3/geometry.svg",
              "format": "svg",
              "resource-policy": "embed",
              "font-policy": "reject",
              "discard": false
            }
          },
          "expect": {
            "status": "changed"
          }
        },
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "before",
            "command": "session.status",
            "params": {}
          },
          "expect": {
            "status": "ok"
          }
        },
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "subject",
            "command": "geometry.move",
            "params": {
              "ids": [
                "shape1"
              ],
              "dx": {
                "value": 2,
                "unit": "px"
              },
              "dy": {
                "value": 3,
                "unit": "px"
              }
            },
            "document": "p9-stale-document",
            "if_revision": {
              "$ref": "before.revision_after"
            }
          },
          "m3": true,
          "expect": {
            "status": "rejected",
            "undo_effect": "none"
          },
          "expect_error": "stale-document"
        }
      ],
      "expect_exit": 0
    },

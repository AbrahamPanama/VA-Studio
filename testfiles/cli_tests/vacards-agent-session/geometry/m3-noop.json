            "params": {}
          },
          "expect": {
            "status": "ok"
          }
        },
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "subject",
            "command": "geometry.move",
            "params": {
              "ids": [
                "shape1"
              ],
              "dx": {
                "value": 0,
                "unit": "px"
              },
              "dy": {
                "value": 0,
                "unit": "px"
              }
            },
            "document": {
              "$ref": "open.document_id"
            },
            "if_revision": {

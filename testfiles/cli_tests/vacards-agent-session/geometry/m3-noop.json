          },
          "m3": true,
          "expect": {
            "status": "unchanged",
            "data": {
              "variant": "unchanged"
            },
            "undo_effect": "none"
          },
          "expect_absent": [
            "error"
          ]
        }
      ],
      "expect_exit": 0
    },

{
  "schema": "p9-m3-cases/1",
  "cases": [
    {
      "id": "history.undo:noop",
      "command": "history.undo",
      "cell": "noop",
      "description": "Independent P9 history.undo:noop",
      "startup_args": [
        "--grant-read",
        "{FIXTURES}/m3"
      ],
      "timeout": 30,
      "requests": [
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "open",
            "command": "file.open",
            "if_revision": 0,
            "params": {
              "path": "{FIXTURES}/m3/selection.svg",
              "format": "svg",
              "resource-policy": "embed",
              "font-policy": "reject",
              "discard": false
            }
          },
          "expect": {
            "status": "changed"
          }
        },
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "before",
            "command": "session.status",
            "params": {}
          },
          "expect": {
            "status": "ok"
          }
        },
        {
          "request": {
            "schema": "va-studio.cli-request/1",
            "id": "subject",
            "command": "history.undo",
            "params": {},
            "document": {
              "$ref": "open.document_id"
            },
            "if_revision": {
              "$ref": "before.revision_after"
            }
          },
          "m3": true,
          "expect": {
            "status": "rejected",
            "undo_effect": "none"
          },
          "expect_error": "history-empty"
        }
      ],
      "expect_exit": 0
    },
    {

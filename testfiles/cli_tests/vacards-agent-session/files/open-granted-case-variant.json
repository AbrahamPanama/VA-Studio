{
  "description": "P9 independent M2 open-granted-case-variant",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "open",
        "command": "file.open",
        "params": {
          "path": "{WORK}/inputs/CASE-EQUIVALENT.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "discard": false
        },
        "if_revision": 0
      },
      "command": "file.open",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/inputs/CASE-EQUIVALENT.svg",
          "sha256": "61859ec258372da15bc80e54bf2fb75c5fec636417c5c702aa400c795d691262",
          "reported": true,
          "hash_field": "data.source_version.sha256",
          "bytes_field": "data.source_version.bytes"
        }
      ],
      "expect_nonempty": [
        "document_id",
        "data.source_version.identity",
        "data.intake"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "query",
        "command": "query.document",
        "params": {}
      },
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "publication": {
          "state": "not-published",
          "persisted": false
        }
      }
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read-file",
    "{WORK}/inputs/case-equivalent.svg"
  ],
  "setup": [
    {
      "op": "copy",
      "source": "{WORK}/inputs/sheet.svg",
      "path": "{WORK}/inputs/case-equivalent.svg"
    }
  ]
}

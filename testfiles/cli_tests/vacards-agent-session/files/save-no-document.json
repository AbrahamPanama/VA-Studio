{
  "description": "P9 independent M2 save-no-document",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "save",
        "command": "file.save",
        "params": {
          "path": "{WORK}/saved.svg",
          "embedding-policy": "embed"
        },
        "if_revision": 0,
        "document": "absent"
      },
      "command": "file.save",
      "cells": [
        "refusal"
      ],
      "expect": {
        "status": "rejected",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_error": "no-document"
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}",
    "--grant-write",
    "{WORK}"
  ]
}

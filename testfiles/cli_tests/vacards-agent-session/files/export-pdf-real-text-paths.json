{
  "description": "P9 independent M2 export-pdf-real-text-paths",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "open",
        "command": "file.open",
        "params": {
          "path": "{WORK}/inputs/text.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "discard": false
        },
        "if_revision": 0
      },
      "command": "file.open",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/inputs/text.svg",
          "sha256": "d8f3476028556bbaff5c320376655e2116b967a8e5a7996d82bda14de183e533",
          "reported": true,
          "hash_field": "data.source_version.sha256",
          "bytes_field": "data.source_version.bytes"
        }
      ],
      "expect_nonempty": [
        "document_id",
        "data.source_version.identity",
        "data.intake"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "export",
        "command": "file.export",
        "params": {
          "path": "{WORK}/output.pdf",
          "format": "pdf",
          "dpi": 96,
          "background": [
            0,
            0,
            0,
            0
          ],
          "text-policy": "paths",
          "overwrite": false,
          "page": 1
        },
        "if_revision": 0,
        "document": {
          "$ref": "open.document_id"
        }
      },
      "command": "file.export",
      "cells": [
        "success",
        "save"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "published",
          "persisted": true
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/output.pdf",
          "format": "pdf",
          "reported": true,
          "size": [
            16,
            8
          ],
          "samples": [],
          "dpi": 96,
          "objects": {},
          "has_text": true,
          "text": "A",
          "text_policy": "paths"
        }
      ]
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}",
    "--grant-write",
    "{WORK}"
  ],
  "fontconfig": "{WORK}/fonts.conf",
  "setup": [
    {
      "op": "write",
      "path": "{WORK}/fonts.conf",
      "text": "<?xml version=\"1.0\"?><!DOCTYPE fontconfig SYSTEM \"urn:fontconfig:fonts.dtd\"><fontconfig><dir>{WORK}/inputs/fonts</dir><cachedir>{WORK}/font-cache</cachedir></fontconfig>"
    }
  ]
}

{
  "description": "P9 independent M2 export-symlink-target-ungranted",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "open",
        "command": "file.open",
        "params": {
          "path": "{WORK}/inputs/sheet.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "discard": false
        },
        "if_revision": 0
      },
      "command": "file.open",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/inputs/sheet.svg",
          "sha256": "61859ec258372da15bc80e54bf2fb75c5fec636417c5c702aa400c795d691262",
          "reported": true,
          "hash_field": "data.source_version.sha256",
          "bytes_field": "data.source_version.bytes"
        }
      ],
      "expect_nonempty": [
        "document_id",
        "data.source_version.identity",
        "data.intake"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "export",
        "command": "file.export",
        "params": {
          "path": "{WORK}/link/output.png",
          "format": "png",
          "dpi": 96,
          "background": [
            0,
            0,
            0,
            0
          ],
          "text-policy": "preserve",
          "overwrite": false,
          "profile": {
            "id": "srgb"
          },
          "drawing": true
        },
        "if_revision": 0,
        "document": {
          "$ref": "open.document_id"
        }
      },
      "command": "file.export",
      "cells": [
        "refusal"
      ],
      "expect": {
        "status": "rejected",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_error": "write-grant-denied",
      "file_oracles": [
        {
          "path": "{WORK}/link/output.png",
          "absent": true
        }
      ],
      "platform_expect": {
        "win32": {
          "expect": {
            "status": "rejected",
            "publication": {
              "state": "not-published",
              "persisted": false
            },
            "undo_effect": "none"
          },
          "expect_error": "unsafe-destination",
          "cells": [
            "refusal"
          ],
          "file_oracles": [
            {
              "path": "{WORK}/link/output.png",
              "absent": true
            },
            {
              "path": "{WORK}/real/output.png",
              "absent": true
            }
          ]
        }
      }
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read-file",
    "{WORK}/inputs/sheet.svg",
    "--grant-write",
    "{WORK}/out"
  ],
  "setup": [
    {
      "op": "mkdir",
      "path": "{WORK}/real"
    },
    {
      "op": "symlink",
      "source": "{WORK}/real",
      "path": "{WORK}/link",
      "directory": true
    },
    {
      "op": "mkdir",
      "path": "{WORK}/out"
    }
  ],
  "windows_symlink_skip": "windows-symlink-creation-not-permitted"
}

{
  "description": "P9 independent M2 one-shot-import-invalid",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "shot-invalid",
        "command": "file.import",
        "params": {
          "path": "{WORK}/inputs/sheet.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "position": {
            "x": {
              "value": 2,
              "unit": "px"
            },
            "y": {
              "value": 3,
              "unit": "px"
            }
          },
          "unknown-key": true
        },
        "if_revision": 0,
        "document": "d1"
      },
      "command": "file.import",
      "cells": [
        "invalid"
      ],
      "expect": {
        "status": "rejected",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_error": "unknown-key",
      "expect_accepted": false
    }
  ],
  "expect_exit": 3,
  "startup_args": [
    "--grant-read",
    "{WORK}/inputs",
    "--grant-write",
    "{WORK}",
    "--document",
    "{WORK}/inputs/sheet.svg"
  ],
  "transport": "one-shot"
}

{
  "description": "P9 independent M2 save-replace-same-bytes",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "open",
        "command": "file.open",
        "params": {
          "path": "{WORK}/inputs/sheet.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "discard": false
        },
        "if_revision": 0
      },
      "command": "file.open",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/inputs/sheet.svg",
          "sha256": "61859ec258372da15bc80e54bf2fb75c5fec636417c5c702aa400c795d691262",
          "reported": true,
          "hash_field": "data.source_version.sha256",
          "bytes_field": "data.source_version.bytes"
        }
      ],
      "expect_nonempty": [
        "document_id",
        "data.source_version.identity",
        "data.intake"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "probe",
        "command": "file.save",
        "params": {
          "path": "{WORK}/target.svg",
          "overwrite": true,
          "embedding-policy": "embed",
          "expected-version": {
            "identity": "wrong",
            "sha256": "61859ec258372da15bc80e54bf2fb75c5fec636417c5c702aa400c795d691262",
            "bytes": 1
          }
        },
        "if_revision": 0,
        "document": {
          "$ref": "open.document_id"
        }
      },
      "command": "file.save",
      "cells": [
        "refusal"
      ],
      "expect": {
        "status": "rejected",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_error": "publication-conflict"
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "retry",
        "command": "file.save",
        "params": {
          "path": "{WORK}/target.svg",
          "overwrite": true,
          "embedding-policy": "embed",
          "expected-version": {
            "$ref": "probe.data.destination_version"
          }
        },
        "if_revision": 0,
        "document": {
          "$ref": "open.document_id"
        }
      },
      "command": "file.save",
      "cells": [
        "refusal"
      ],
      "expect": {
        "status": "rejected",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_error": "publication-conflict",
      "before": [
        {
          "op": "replace-same-bytes",
          "path": "{WORK}/target.svg"
        }
      ],
      "file_oracles": [
        {
          "path": "{WORK}/target.svg",
          "sha256": "61859ec258372da15bc80e54bf2fb75c5fec636417c5c702aa400c795d691262"
        }
      ]
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}",
    "--grant-write",
    "{WORK}"
  ],
  "setup": [
    {
      "op": "copy",
      "source": "{WORK}/inputs/sheet.svg",
      "path": "{WORK}/target.svg"
    }
  ]
}

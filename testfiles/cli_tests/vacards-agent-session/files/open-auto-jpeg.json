{
  "description": "P9 independent M2 open-auto-jpeg",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "open",
        "command": "file.open",
        "params": {
          "path": "{WORK}/inputs/photo.jpg",
          "format": "auto",
          "resource-policy": "embed",
          "font-policy": "reject",
          "discard": false
        },
        "if_revision": 0
      },
      "command": "file.open",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/inputs/photo.jpg",
          "sha256": "727a7dfb76d6d7f21b7fd3a477e5e4bf24f1f3c00311c7eb3cc76194fee4455f",
          "reported": true,
          "hash_field": "data.source_version.sha256",
          "bytes_field": "data.source_version.bytes"
        }
      ],
      "expect_nonempty": [
        "document_id",
        "data.source_version.identity",
        "data.intake"
      ]
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}",
    "--grant-write",
    "{WORK}"
  ]
}

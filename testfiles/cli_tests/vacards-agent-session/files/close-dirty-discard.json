{
  "description": "P9 independent M2 close-dirty-discard",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "new",
        "command": "file.new",
        "params": {
          "width": {
            "value": 16,
            "unit": "px"
          },
          "height": {
            "value": 8,
            "unit": "px"
          },
          "discard": false
        },
        "if_revision": 0
      },
      "command": "file.new",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "discard",
        "command": "file.close",
        "params": {
          "discard": true
        },
        "if_revision": 1,
        "document": {
          "$ref": "new.document_id"
        }
      },
      "command": "file.close",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ]
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}",
    "--grant-write",
    "{WORK}"
  ]
}

{
  "description": "P9 independent M2 import-format-cdr",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "open",
        "command": "file.open",
        "params": {
          "path": "{WORK}/inputs/empty.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "discard": false
        },
        "if_revision": 0
      },
      "command": "file.open",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/inputs/empty.svg",
          "sha256": "a92954cb173804ee820df600736ed453595fe9e5205c8f3d740024f79d88dd98",
          "reported": true,
          "hash_field": "data.source_version.sha256",
          "bytes_field": "data.source_version.bytes"
        }
      ],
      "expect_nonempty": [
        "document_id",
        "data.source_version.identity",
        "data.intake"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "import",
        "command": "file.import",
        "params": {
          "path": "{WORK}/inputs/sheet.cdr",
          "format": "cdr",
          "resource-policy": "embed",
          "font-policy": "reject",
          "position": {
            "x": {
              "value": 0,
              "unit": "px"
            },
            "y": {
              "value": 0,
              "unit": "px"
            }
          }
        },
        "if_revision": 0,
        "document": {
          "$ref": "open.document_id"
        }
      },
      "command": "file.import",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "one-step"
      },
      "expect_absent": [
        "error"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "save",
        "command": "file.save",
        "params": {
          "path": "{WORK}/saved.svg",
          "embedding-policy": "embed",
          "overwrite": false
        },
        "if_revision": {
          "$ref": "import.revision_after"
        },
        "document": {
          "$ref": "open.document_id"
        }
      },
      "command": "file.save",
      "cells": [
        "success",
        "save"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "published",
          "persisted": true
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/saved.svg",
          "format": "svg",
          "reported": true,
          "embedded": true
        }
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "close",
        "command": "file.close",
        "params": {
          "discard": true
        },
        "if_revision": 1,
        "document": {
          "$ref": "open.document_id"
        }
      },
      "command": "file.close",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "reopen",
        "command": "file.open",
        "params": {
          "path": "{WORK}/saved.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "discard": false
        },
        "if_revision": 2
      },
      "command": "file.open",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "export",
        "command": "file.export",
        "params": {
          "path": "{WORK}/output.png",
          "format": "png",
          "dpi": 96,
          "background": [
            0,
            0,
            0,
            0
          ],
          "text-policy": "preserve",
          "overwrite": false,
          "profile": {
            "id": "srgb"
          },
          "area": {
            "x": {
              "value": 0,
              "unit": "px"
            },
            "y": {
              "value": 0,
              "unit": "px"
            },
            "width": {
              "value": 210,
              "unit": "mm"
            },
            "height": {
              "value": 297,
              "unit": "mm"
            }
          }
        },
        "if_revision": 0,
        "document": {
          "$ref": "reopen.document_id"
        }
      },
      "command": "file.export",
      "cells": [
        "success",
        "save"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "published",
          "persisted": true
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/output.png",
          "format": "png",
          "reported": true,
          "size": [
            794,
            1123
          ],
          "samples": [],
          "dpi": 96,
          "reference": "{WORK}/inputs/sheet-cdr-reference.png",
          "mean_tolerance": 3
        }
      ]
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}",
    "--grant-write",
    "{WORK}"
  ]
}

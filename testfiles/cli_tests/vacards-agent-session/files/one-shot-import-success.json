{
  "description": "P9 independent M2 one-shot-import-success",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "shot",
        "command": "file.import",
        "params": {
          "path": "{WORK}/inputs/sheet.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "position": {
            "x": {
              "value": 2,
              "unit": "px"
            },
            "y": {
              "value": 3,
              "unit": "px"
            }
          }
        },
        "if_revision": 0,
        "document": "d1"
      },
      "command": "file.import",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "one-step"
      },
      "expect_absent": [
        "error"
      ]
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}/inputs",
    "--grant-write",
    "{WORK}",
    "--document",
    "{WORK}/inputs/sheet.svg"
  ],
  "transport": "one-shot"
}

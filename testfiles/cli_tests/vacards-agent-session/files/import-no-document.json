{
  "description": "P9 independent M2 import-no-document",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "import",
        "command": "file.import",
        "params": {
          "path": "{WORK}/inputs/sheet.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "position": {
            "x": {
              "value": 2,
              "unit": "px"
            },
            "y": {
              "value": 3,
              "unit": "px"
            }
          }
        },
        "if_revision": 0,
        "document": "absent"
      },
      "command": "file.import",
      "cells": [
        "refusal"
      ],
      "expect": {
        "status": "rejected",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_error": "no-document"
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}",
    "--grant-write",
    "{WORK}"
  ]
}

{
  "description": "P9 independent M2 matrix-import-svgz-auto-page1-reject-external-reject",
  "timeout": 30,
  "requests": [
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "open",
        "command": "file.open",
        "params": {
          "path": "{WORK}/inputs/empty.svg",
          "format": "svg",
          "resource-policy": "embed",
          "font-policy": "reject",
          "discard": false
        },
        "if_revision": 0
      },
      "command": "file.open",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "none"
      },
      "expect_absent": [
        "error"
      ],
      "file_oracles": [
        {
          "path": "{WORK}/inputs/empty.svg",
          "sha256": "a92954cb173804ee820df600736ed453595fe9e5205c8f3d740024f79d88dd98",
          "reported": true,
          "hash_field": "data.source_version.sha256",
          "bytes_field": "data.source_version.bytes"
        }
      ],
      "expect_nonempty": [
        "document_id",
        "data.source_version.identity",
        "data.intake"
      ]
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "policy-import",
        "command": "file.import",
        "params": {
          "path": "{WORK}/inputs/sheet.svgz",
          "format": "auto",
          "resource-policy": "reject-external",
          "font-policy": "reject",
          "pages": [
            1
          ],
          "position": {
            "x": {
              "value": 0,
              "unit": "px"
            },
            "y": {
              "value": 0,
              "unit": "px"
            }
          }
        },
        "if_revision": 0,
        "document": {
          "$ref": "open.document_id"
        }
      },
      "command": "file.import",
      "cells": [
        "success"
      ],
      "expect": {
        "status": "changed",
        "publication": {
          "state": "not-published",
          "persisted": false
        },
        "undo_effect": "one-step"
      },
      "expect_absent": [
        "error"
      ],
      "expect_exact": {
        "data.root_affines.0.affine": [
          1,
          0,
          0,
          1,
          0,
          0
        ]
      }
    },
    {
      "request": {
        "schema": "va-studio.cli-request/1",
        "id": "dimensions",
        "command": "query.document",
        "params": {}
      },
      "expect": {
        "status": "ok",
        "undo_effect": "none",
        "publication": {
          "state": "not-published",
          "persisted": false
        }
      },
      "expect_numeric": {
        "data.size.width.px": {
          "value": 16,
          "abs": 1e-06
        },
        "data.size.height.px": {
          "value": 8,
          "abs": 1e-06
        }
      }
    }
  ],
  "expect_exit": 0,
  "startup_args": [
    "--grant-read",
    "{WORK}",
    "--grant-write",
    "{WORK}"
  ]
}

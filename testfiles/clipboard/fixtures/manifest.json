{
  "manifest_version": 1,
  "description": "Synthetic fixtures for the external-process clipboard paste protocol (milestone A, E-series). Expected values are authored from the paste protocol specification and the recorded discovery tests, never computed by the production helper under test.",
  "semantics": {
    "text_sha256": "SHA-256 of the UTF-8 bytes the document text must contain after the paste (success) or of the unchanged document text (reject/abort: the empty string, hash e3b0c442...b855)",
    "text_bytes": "UTF-8 byte length of that same expected document text",
    "transport_bytes": "bytes the receiver sees on the clipboard wire: the sum over publish.macos representations of their byte counts plus one terminal NUL per string representation (the macOS public.utf8-plain-text string path appends exactly one), and it must be one of the representations",
    "object_count": "number of new TEXT objects the case must create (0 when document_unchanged is true and also 0 for import-object, which must create no text object)",
    "undo_steps": "number of Undo entries the case must add",
    "required_formats": "GTK MIME names the receiver must observe on the live remote clipboard before pasting",
    "failure_class": "success | abort-no-mutation | reject-no-mutation | fallback-plain | import-object | no-op",
    "publish.macos": "legacy {utis[], as} publishes the fixture file under every UTI; extended {representations:[{uti,file,sha256,bytes,as,stall}]} gives each representation its own payload (stall:true = advertised through a data provider that never delivers)",
    "import_object_id": "import-object only: element id that must appear after the paste and exists ONLY in the SVG/object representation",
    "forbidden_text_utf8": "distinctive string (or list of strings) from the LOSING representation that must never become document text; required for fallback-plain and import-object, must occur in a published payload and must not occur in the expected text",
    "max_elapsed_ms": "upper bound on one paste command's wall time, required when a representation declares stall:true and only valid when at least one does"
  },
